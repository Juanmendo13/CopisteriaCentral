# Pedidos / presupuestos → Outlook de la tienda (único buzón)
PEDIDOS_EMAIL=pizzeriaformula1@outlook.es
SITE_URL=https://copisteria-central.vercel.app

# Primario: servidor → Resend → PEDIDOS_EMAIL (Outlook).
# En modo prueba (onboarding@resend.dev) solo entrega a la cuenta verificada = Outlook.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Copistería Central <onboarding@resend.dev>

# Opcional: Web3Forms solo si la Access Key está ligada a Outlook (p. ej. key A0).
# Keys creadas con Gmail se ignoran (no reenvían al buzón antiguo).
# WEB3FORMS_ACCESS_KEY=

# Vercel Blob (PDF en /pedido + catálogo JSON en /admin)
BLOB_READ_WRITE_TOKEN=

# Admin /admin — obligatorio para abrir el panel (fail closed si falta password)
ADMIN_USER=admin
ADMIN_PASSWORD=
# Opcional: firma de la cookie de sesión (si falta, se deriva de ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=
# ADMIN_SECRET=
