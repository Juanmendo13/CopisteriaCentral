# Resend — envío de pedidos / presupuestos
RESEND_API_KEY=re_xxxxxxxx
#
# RESEND_FROM sigue en onboarding@resend.dev → sin dominio verificado.
# PEDIDOS_EMAIL apunta al Gmail pedido; los envíos FALLAN hasta verificar dominio.
RESEND_FROM=Copistería Central <onboarding@resend.dev>
PEDIDOS_EMAIL=bellamorenoeugenio820@gmail.com
#
# Para que la entrega a Gmail funcione:
# 1) Verifica un dominio en https://resend.com/domains
# 2) RESEND_FROM=Copistería Central <pedidos@tu-dominio-verificado>
# 3) PEDIDOS_EMAIL=bellamorenoeugenio820@gmail.com (ya configurado)
# 4) (opcional) RESEND_DOMAIN_VERIFIED=true  → confirma presupuesto al email del cliente
# RESEND_DOMAIN_VERIFIED=false
#
# Mientras no haya dominio, el único destinatario que Resend acepta con
# onboarding@resend.dev es el email de la cuenta: pizzeriaformula1@outlook.es

BLOB_READ_WRITE_TOKEN=
WEB3FORMS_ACCESS_KEY=
