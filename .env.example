# Pedidos / presupuestos → Gmail de la tienda
PEDIDOS_EMAIL=bellamorenoeugenio820@gmail.com
SITE_URL=https://copisteria-central.vercel.app

# Primario: navegador → Web3Forms (Access Key creada con PEDIDOS_EMAIL / Gmail).
WEB3FORMS_ACCESS_KEY=
# Opcional (legado). Ya no hace falta: cualquier key no-Outlook cuenta como lista.
# WEB3FORMS_GMAIL_READY=1

# Copia de seguridad Resend → Outlook de prueba (onboarding@resend.dev no puede a Gmail)
# Tras el pedido también intenta confirmación al email del cliente con el desglose.
# En modo prueba Resend solo entrega a la cuenta verificada: para clientes reales,
# verifica un dominio en https://resend.com/domains y pon RESEND_FROM en ese dominio.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Copistería Central <onboarding@resend.dev>
# PEDIDOS_FALLBACK_EMAIL=pizzeriaformula1@outlook.es

# Vercel Blob (PDF en /pedido + catálogo JSON en /admin)
BLOB_READ_WRITE_TOKEN=

# Admin /admin — obligatorio para abrir el panel (fail closed si falta password)
ADMIN_USER=admin
ADMIN_PASSWORD=
# Opcional: firma de la cookie de sesión (si falta, se deriva de ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=
# ADMIN_SECRET=
