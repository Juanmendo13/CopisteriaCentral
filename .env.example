# Pedidos / presupuestos → Gmail de la tienda (FormSubmit, sin dominio Resend)
PEDIDOS_EMAIL=bellamorenoeugenio820@gmail.com

# FormSubmit entrega a PEDIDOS_EMAIL. La primera vez hay que pulsar
# “Activate Form” en el correo que FormSubmit manda a ese Gmail.
# SITE_URL se usa como Origin en el aviso server-side.
SITE_URL=https://copisteria-central.vercel.app

# Opcional: Resend (solo si más adelante verificáis un dominio propio)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Copistería Central <pedidos@tu-dominio-verificado>
# RESEND_DOMAIN_VERIFIED=true

# Vercel Blob (subida de PDF en /pedido)
BLOB_READ_WRITE_TOKEN=

# Legacy / opcional (presupuesto contacto ya no depende de Web3Forms)
WEB3FORMS_ACCESS_KEY=
