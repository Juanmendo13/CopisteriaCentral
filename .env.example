# Pedidos / presupuestos → Gmail de la tienda
PEDIDOS_EMAIL=bellamorenoeugenio820@gmail.com
SITE_URL=https://copisteria-central.vercel.app

# Primario: navegador → Web3Forms (key creada con PEDIDOS_EMAIL / Gmail).
# En prod ya hay key + WEB3FORMS_GMAIL_READY=1; solo regenera si rotas la key.
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_GMAIL_READY=1

# Copia de seguridad Resend → Outlook de prueba (onboarding@resend.dev no puede a Gmail)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Copistería Central <onboarding@resend.dev>
# PEDIDOS_FALLBACK_EMAIL=pizzeriaformula1@outlook.es

# Vercel Blob (subida de PDF en /pedido)
BLOB_READ_WRITE_TOKEN=
