---
import { site } from '../lib/site';
---

<section class="bg-brand-dark/95 text-white/80">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-4 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-x-8 sm:gap-y-2 text-sm">
    <p>
      <span class="text-white/45">Dónde · </span>
      <span class="text-white font-medium">{site.landmark}</span>
    </p>
    <p>
      <span class="text-white/45">Horario · </span>
      <span class="text-white font-medium">L–J 9:00–20:30</span>
      <span class="text-white/45"> · Sáb 9:30–13:30</span>
    </p>
    <p>
      <span class="text-white/45">Tel. · </span>
      <a href={site.phoneHref} class="text-accent font-medium hover:underline">{site.phone}</a>
    </p>
  </div>
</section>
