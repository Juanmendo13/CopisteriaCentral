---
import { site } from '../lib/site';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  variant?: 'tech' | 'negocios';
}

const { variant = 'tech' } = Astro.props;
const isNegocios = variant === 'negocios';
---

<header class="absolute inset-x-0 top-0 z-40">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-4 sm:px-8 sm:py-5"
    data-i18n-attr="aria-label:nav.aria"
    aria-label="Principal"
  >
    <a
      href={isNegocios ? '/negocios' : '/'}
      class="font-display text-lg font-extrabold tracking-[0.14em] text-acid drop-shadow-[0_0_18px_rgb(184_255_61_/_0.35)] sm:text-xl"
    >
      {site.brand}<span class="text-cyan">_</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      <ul class="hidden items-center gap-1 sm:flex sm:gap-2">
        {
          isNegocios ? (
            <>
              <li>
                <a
                  href="#que-hago"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-mist transition hover:text-acid sm:px-3"
                  data-i18n="nav.benefits"
                >
                  Qué te hago
                </a>
              </li>
              <li>
                <a
                  href="#casos"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-mist transition hover:text-acid sm:px-3"
                  data-i18n="nav.cases"
                >
                  Casos
                </a>
              </li>
              <li>
                <a
                  href="#contacto"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-mist transition hover:text-acid sm:px-3"
                  data-i18n="nav.contact"
                >
                  Contacto
                </a>
              </li>
              <li>
                <a
                  href="/"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-cyan transition hover:text-acid sm:px-3"
                  data-i18n="nav.tech"
                >
                  Ver perfil técnico
                </a>
              </li>
            </>
          ) : (
            <>
              <li>
                <a
                  href="#proyectos"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-mist transition hover:text-acid sm:px-3"
                  data-i18n="nav.work"
                >
                  Proyectos
                </a>
              </li>
              <li>
                <a
                  href="#sobre"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-mist transition hover:text-acid sm:px-3"
                  data-i18n="nav.about"
                >
                  Sobre mí
                </a>
              </li>
              <li>
                <a
                  href="#contacto"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-mist transition hover:text-acid sm:px-3"
                  data-i18n="nav.contact"
                >
                  Contacto
                </a>
              </li>
              <li>
                <a
                  href="/negocios"
                  class="px-2 py-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-cyan transition hover:text-acid sm:px-3"
                  data-i18n="nav.negocios"
                >
                  ¿Tienes un local?
                </a>
              </li>
            </>
          )
        }
      </ul>
      {/* Mobile cross-link when nav items are hidden */}
      {
        isNegocios ? (
          <a
            href="/"
            class="font-mono text-[10px] uppercase tracking-[0.14em] text-cyan sm:hidden"
            data-i18n="nav.tech"
          >
            Ver perfil técnico
          </a>
        ) : (
          <a
            href="/negocios"
            class="font-mono text-[10px] uppercase tracking-[0.14em] text-cyan sm:hidden"
            data-i18n="nav.negocios"
          >
            ¿Tienes un local?
          </a>
        )
      }
      <LangSwitcher />
    </div>
  </nav>
</header>
