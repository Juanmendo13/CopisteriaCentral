---
import { site } from '../lib/site';

const links = [
  { href: '#trabajo', label: 'Trabajo' },
  { href: '#enfoque', label: 'Enfoque' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="absolute inset-x-0 top-0 z-40">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 sm:px-8"
    aria-label="Principal"
  >
    <a
      href="/"
      class="font-display text-lg font-extrabold tracking-tight text-white drop-shadow-sm sm:text-xl"
    >
      {site.name}
    </a>
    <ul class="flex items-center gap-0.5 sm:gap-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="px-1.5 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-white/80 transition hover:text-white sm:px-3 sm:text-xs sm:tracking-[0.14em]"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
