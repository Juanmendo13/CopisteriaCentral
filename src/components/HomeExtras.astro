---
import { site } from '../lib/site';

const features = [
  {
    title: 'Junto al campus',
    text: 'En Reina Mercedes, cerca de ETSII. Pasas, fotocopias y recoges.',
  },
  {
    title: 'Horario largo',
    text: 'De las primeras en abrir y de las últimas en cerrar en la avenida.',
  },
  {
    title: 'Todo lo básico',
    text: 'Fotocopias, color, encuadernación, plastificados y papelería.',
  },
  {
    title: 'Trato directo',
    text: 'Rápidos, baratos y con el material que pedís a última hora.',
  },
];
---

<section class="px-4 py-16 sm:py-20 bg-white border-b border-line">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-2xl mb-10">
      <p class="text-[11px] font-extrabold uppercase tracking-[0.28em] text-brand border-l-2 border-accent pl-3 mb-4">
        Por qué Central
      </p>
      <h2 class="font-display text-3xl sm:text-4xl font-black tracking-[-0.025em] text-ink">
        La opción de referencia en Reina Mercedes
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 border border-line">
      {
        features.map((item, i) => (
          <div
            class:list={[
              'p-5 sm:p-6 bg-white',
              i < 3 && 'lg:border-r border-line',
              i % 2 === 0 && 'sm:border-r lg:border-r-0',
              i < 2 && 'border-b sm:border-b lg:border-b-0 border-line',
              i >= 2 && i < 4 && 'border-b lg:border-b-0 border-line sm:border-b-0',
              i === 2 && 'sm:border-r lg:border-r border-line',
            ]}
          >
            <p class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-accent mb-3">0{i + 1}</p>
            <h3 class="font-black text-ink tracking-tight">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted font-medium">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-brand-dark text-white border-b-4 border-accent">
  <div class="max-w-6xl mx-auto px-4 py-12 sm:py-14 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
    <div>
      <p class="text-[11px] font-extrabold uppercase tracking-[0.28em] text-accent mb-3">Venta de papelería</p>
      <h2 class="font-display text-2xl sm:text-3xl font-black tracking-tight">Bolígrafos, libretas y más</h2>
      <p class="mt-3 max-w-xl text-white/60 leading-relaxed font-medium">
        Catálogo online, lista de compra y recogida en {site.addressLine}.
      </p>
    </div>
    <div class="flex flex-wrap gap-3 shrink-0">
      <a href="/venta" class="btn-accent inline-flex items-center justify-center px-6 py-3.5 text-xs font-black uppercase tracking-wide">
        Ir a venta
      </a>
      <a
        href={site.phoneHref}
        class="btn-secondary inline-flex items-center justify-center px-6 py-3.5 text-xs font-black uppercase tracking-wide text-white"
      >
        Llamar
      </a>
    </div>
  </div>
</section>
