---
import { site } from '../lib/site';
import Doodle from './Doodle.astro';

const features = [
  {
    title: 'Junto al campus',
    text: 'En Reina Mercedes, cerca de ETSII. Entre clase y clase: pasas, fotocopias y sigues.',
    doodle: 'cuaderno' as const,
    tone: 'bg-brand text-white',
  },
  {
    title: 'Horario largo',
    text: 'De las primeras en abrir y de las últimas en cerrar en la avenida.',
    doodle: 'regla' as const,
    tone: 'bg-accent text-brand-dark',
  },
  {
    title: 'Lo que hace falta',
    text: 'Fotocopias, color, espirales, plastificados y la papelería de apuro.',
    doodle: 'tijeras' as const,
    tone: 'bg-coral text-white',
  },
  {
    title: 'Trato de barrio',
    text: 'Rápidos, claros y con lo que pedís a última hora — sin dramas.',
    doodle: 'boli' as const,
    tone: 'bg-white text-brand border-brand',
  },
];
---

<section class="relative px-5 sm:px-8 py-16 sm:py-20 bg-paper-deep overflow-hidden border-y-[8px] border-brand">
  <Doodle name="cinta" rotate={12} class="doodle-float absolute top-6 right-8 h-14 w-14 opacity-40 hidden md:block" />
  <div class="relative max-w-6xl mx-auto">
    <div class="max-w-xl mb-12">
      <p class="text-sm font-black text-coral mb-2 inline-flex items-center gap-2 uppercase tracking-[0.14em]">
        <Doodle name="postit" class="h-5 w-5" rotate={8} />
        Por qué la gente vuelve
      </p>
      <h2 class="font-display text-3xl sm:text-5xl text-brand leading-[1.02]">
        Tu copistería de siempre en Reina Mercedes
      </h2>
    </div>
    {/* Color blocks — not icon+text soft cards */}
    <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
      {
        features.map((item, i) => (
          <div
            class:list={[
              'border-[4px] border-brand-dark p-6 sm:p-7 shadow-[6px_6px_0_rgba(0,26,61,0.3)]',
              item.tone,
              i === 1 && 'sm:translate-y-4',
              i === 2 && 'sm:-translate-y-2',
            ]}
          >
            <span class="stamp-mark h-12 w-12 mb-4">
              <Doodle name={item.doodle} class="h-7 w-7" rotate={item.doodle === 'boli' ? 12 : -6} />
            </span>
            <h3 class="font-display text-xl sm:text-2xl leading-tight">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed font-semibold opacity-85">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="band-mustard relative overflow-hidden">
  <Doodle name="lapiz" rotate={18} class="doodle-float absolute right-6 top-4 h-20 w-6 opacity-50 hidden sm:block" />
  <Doodle name="goma" rotate={-10} class="absolute left-6 bottom-4 h-8 w-12 opacity-40" />
  <div class="relative max-w-6xl mx-auto px-5 sm:px-8 py-12 sm:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <p class="text-sm font-black text-brand/70 mb-2 inline-flex items-center gap-2 uppercase tracking-[0.14em]">
        <Doodle name="boli" class="h-6 w-3" rotate={-8} />
        Papelería
      </p>
      <h2 class="font-display text-2xl sm:text-4xl text-brand leading-tight">Bolis, libretas y lo que se te olvida</h2>
      <p class="mt-3 max-w-lg text-brand/80 text-sm sm:text-base leading-relaxed font-semibold">
        Mira el catálogo, haz tu lista y pásate a recogerlo en {site.addressLine}.
      </p>
    </div>
    <div class="relative flex flex-wrap gap-3 shrink-0">
      <a href="/venta" class="inline-flex items-center gap-2 px-6 py-3.5 text-xs font-black uppercase tracking-wide bg-brand text-accent border-[3px] border-brand-dark shadow-[5px_5px_0_rgba(0,26,61,0.4)] hover:translate-x-[-2px] hover:translate-y-[-2px] transition">
        <Doodle name="cuaderno" class="h-5 w-4" />
        Ir a venta
      </a>
      <a href={site.phoneHref} class="inline-flex items-center px-6 py-3.5 text-xs font-black uppercase tracking-wide border-[3px] border-brand text-brand hover:bg-brand hover:text-accent transition">
        Llamar
      </a>
    </div>
  </div>
</section>
