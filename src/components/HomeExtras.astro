---
import { site } from '../lib/site';

const notes = [
  {
    title: 'A un paso del campus',
    text: 'Reina Mercedes, Local B, al lado de la ETSII. Sales de clase y entras.',
  },
  {
    title: 'La persiana sube pronto',
    text: 'De las primeras en abrir la avenida y de las últimas en bajarla.',
  },
  {
    title: 'Lo de siempre, bien hecho',
    text: 'Copias, color, espiral, plastificado y la grapadora que ya no encuentras.',
  },
  {
    title: 'Te lo decimos de frente',
    text: 'Si el PDF va mal, te avisamos antes de gastar papel. Y si es para mañana, dínoslo.',
  },
];
---

<section class="px-5 sm:px-8 py-14 sm:py-16">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-xl mb-8">
      <p class="stamp text-brand mb-4">Así es el mostrador</p>
      <h2 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink leading-tight">
        No es una web de imprenta. Es el mostrador de siempre.
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      {
        notes.map((item, index) => (
          <article
            class:list={[
              'counter-note px-5 py-5',
              index % 2 === 1 ? 'sm:rotate-[0.4deg]' : 'sm:-rotate-[0.35deg]',
            ]}
          >
            <h3 class="font-display italic text-xl text-brand">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/80">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="mx-5 sm:mx-8 mb-14">
  <div class="max-w-6xl mx-auto bg-brand text-white px-6 py-9 sm:px-10 sm:py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <p class="font-display italic text-accent mb-2">El estante de al lado</p>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold tracking-tight">Bolis, libretas y lo que se acaba</h2>
      <p class="mt-2 max-w-lg text-white/70 text-sm leading-relaxed">
        Haz la lista desde casa y recógela en {site.addressLine}. Si falta algo, te lo decimos por teléfono.
      </p>
    </div>
    <div class="flex flex-wrap gap-3 shrink-0">
      <a href="/venta" class="btn-accent inline-flex items-center px-5 py-2.5 text-sm">
        Ver el estante
      </a>
      <a href={site.phoneHref} class="btn-secondary inline-flex items-center px-5 py-2.5 text-sm text-white">
        Llamar al local
      </a>
    </div>
  </div>
</section>
