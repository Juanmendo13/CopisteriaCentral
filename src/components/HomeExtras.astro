---
import { site } from '../lib/site';

const features = [
  {
    title: 'Junto al campus',
    text: 'En Reina Mercedes, cerca de ETSII. Pasas, fotocopias y recoges.',
  },
  {
    title: 'Horario largo',
    text: 'De las primeras en abrir y de las últimas en cerrar en la avenida.',
  },
  {
    title: 'Todo lo básico',
    text: 'Fotocopias, color, encuadernación, plastificados y papelería.',
  },
  {
    title: 'Trato directo',
    text: 'Rápidos, baratos y con el material que pedís a última hora.',
  },
];
---

<section class="px-5 sm:px-8 py-14 sm:py-16 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-xl mb-8">
      <p class="text-sm font-medium text-brand mb-2">Por qué venir aquí</p>
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-ink">
        La copistería de referencia en Reina Mercedes
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-x-10 gap-y-8">
      {
        features.map((item) => (
          <div>
            <h3 class="font-semibold text-ink">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="mx-5 sm:mx-8 mb-14">
  <div class="max-w-6xl mx-auto rounded-2xl bg-brand text-white px-6 py-9 sm:px-10 sm:py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <p class="text-sm text-accent mb-2 font-medium">Papelería</p>
      <h2 class="font-display text-xl sm:text-2xl font-bold tracking-tight">Bolígrafos, libretas y más</h2>
      <p class="mt-2 max-w-lg text-white/65 text-sm leading-relaxed">
        Mira el catálogo, haz tu lista y recoge en {site.addressLine}.
      </p>
    </div>
    <div class="flex flex-wrap gap-3 shrink-0">
      <a href="/venta" class="btn-accent inline-flex items-center px-5 py-2.5 text-sm">
        Ir a venta
      </a>
      <a href={site.phoneHref} class="btn-secondary inline-flex items-center px-5 py-2.5 text-sm text-white">
        Llamar
      </a>
    </div>
  </div>
</section>
