---
import { formatEuro, getPrecioItem } from '../data/precios';
import SectionHeader from './SectionHeader.astro';

const destacados = [
  'foto-bn-a4',
  'foto-color-a4',
  'imp-a4-color',
  'espiral-a4',
  'plastificado-a4',
  'diseno-grafico',
]
  .map((id) => getPrecioItem(id))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<section id="precios" class="scroll-mt-24 px-5 sm:px-8 py-14 sm:py-16 bg-paper">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <SectionHeader
        eyebrow="Tarifa de puerta"
        title="Lo básico, escrito a la vista"
        description="Precios de mostrador, para que no preguntes a ciegas. El resto se confirma en el local."
      />
      <a href="/precios" class="btn-accent shrink-0 inline-flex items-center px-4 py-2 text-sm self-start">
        Ver tarifas
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {
        destacados.map((item) => (
          <a
            href="/precios"
            class="price-ticket block border border-line px-4 py-4 hover:border-brand/30 transition"
          >
            <p class="text-xs text-muted mb-1">{item.categoria}</p>
            <h3 class="font-semibold text-ink text-[15px] leading-snug">
              {item.nombre}
            </h3>
            <p class="mt-2 text-base font-bold text-ink">
              {item.modo === 'consultar' || item.precio == null ? (
                <span class="text-sm font-semibold text-brand">Consultar</span>
              ) : (
                <>
                  {formatEuro(item.precio)}
                  <span class="text-sm font-medium text-muted"> / {item.unidad}</span>
                </>
              )}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
