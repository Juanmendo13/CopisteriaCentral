---
import { formatEuro, getPrecioItem } from '../data/precios';
import SectionHeader from './SectionHeader.astro';

const destacados = [
  'foto-bn-a4',
  'foto-color-a4',
  'imp-a4-color',
  'espiral-a4',
  'plastificado-a4',
  'diseno-grafico',
]
  .map((id) => getPrecioItem(id))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<section id="precios" class="scroll-mt-24 px-4 py-16 sm:py-20 bg-paper border-b border-line">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
      <SectionHeader
        eyebrow="Tarifas"
        title="Lo básico, a la vista"
        description="Precios orientativos de mostrador. El resto se confirma en el local."
      />
      <a href="/precios" class="btn-accent shrink-0 inline-flex items-center px-5 py-2.5 text-xs font-black uppercase tracking-wide">
        Ver tarifas y presupuesto
      </a>
    </div>

    <div class="border border-line bg-white divide-y divide-line">
      {
        destacados.map((item) => (
          <a
            href="/precios"
            class="group flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-5 py-4 hover:bg-brand-soft/40 transition-colors"
          >
            <div class="min-w-0">
              <p class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-muted">{item.categoria}</p>
              <h3 class="mt-0.5 font-bold text-ink group-hover:text-brand transition">
                {item.nombre}
              </h3>
            </div>
            <p class="text-base font-black text-ink sm:text-right shrink-0">
              {item.modo === 'consultar' || item.precio == null ? (
                <span class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-brand">
                  Pendiente de evaluación
                </span>
              ) : (
                <>
                  {formatEuro(item.precio)}
                  <span class="text-sm font-medium text-muted"> / {item.unidad}</span>
                </>
              )}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
