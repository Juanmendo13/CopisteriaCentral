---
import type { Servicio } from '../data/servicios';
import { servicioEsPedido, servicioHref } from '../data/formatos';
import { precioTarjetaServicio } from '../data/precios';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  servicio: Servicio;
  featured?: boolean;
}

const { servicio, featured: featuredProp } = Astro.props;
const featured = featuredProp ?? servicio.featured ?? false;
const fullWidth = servicio.fullWidth ?? false;
const esPedido = servicioEsPedido(servicio.slug);
const precio = precioTarjetaServicio(servicio.slug);
const esVenta = servicio.slug === 'papeleria';
---

<a
  href={servicioHref(servicio.slug)}
  class:list={[
    'group flex h-full flex-col bg-white transition-colors duration-200 hover:bg-brand-soft/60',
    fullWidth ? 'sm:col-span-2 lg:col-span-3 p-6 sm:p-8' : 'p-5 sm:p-6',
    featured && 'bg-brand-soft/40',
  ]}
>
  <div class:list={[fullWidth && 'sm:flex sm:items-start sm:justify-between sm:gap-8']}>
    <div class:list={['flex-1', fullWidth && 'min-w-0']}>
      <div class="flex items-start gap-3">
        <ServiceIcon slug={servicio.slug} featured={featured} />
        <div class="min-w-0 flex-1">
          <h3
            class:list={[
              'font-black text-ink tracking-tight transition group-hover:text-brand',
              fullWidth ? 'text-xl sm:text-2xl' : 'text-base',
            ]}
          >
            {servicio.title}
          </h3>
          {
            featured && (
              <span class="mt-1.5 inline-block text-[10px] font-extrabold uppercase tracking-[0.18em] text-brand border-b border-accent pb-0.5">
                {esVenta ? 'Tienda' : 'Especialidad'}
              </span>
            )
          }
        </div>
      </div>
      <p
        class:list={[
          'mt-3 leading-relaxed text-muted font-medium',
          fullWidth ? 'text-base max-w-3xl' : 'flex-1 text-sm',
        ]}
      >
        {servicio.short}
      </p>
      {
        fullWidth && servicio.items.length > 0 && (
          <ul class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
            {servicio.items.map((item) => (
              <li class="flex items-center gap-2 text-sm text-ink font-medium">
                <span class="h-1 w-1 shrink-0 bg-accent" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        )
      }
      {
        !fullWidth && servicio.formats && (
          <p class="mt-3 text-[11px] font-bold tracking-[0.12em] text-muted uppercase">
            {servicio.formats.join(' · ')}
          </p>
        )
      }
      {
        precio && (
          <p class="mt-3 text-sm font-black text-ink">
            {precio.tipo === 'desde' ? (
              <>
                <span class="text-brand">{precio.etiqueta}</span>
                <span class="ml-1 text-xs font-medium text-muted">orientativo</span>
              </>
            ) : (
              <span class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-brand">
                {precio.etiqueta}
              </span>
            )}
          </p>
        )
      }
    </div>
    <span
      class:list={[
        'mt-4 inline-flex w-fit px-0 py-1 text-xs font-black uppercase tracking-wide transition-colors duration-200',
        fullWidth
          ? 'sm:mt-0 btn-accent shrink-0 self-start px-4 py-2'
          : 'text-brand border-b border-transparent group-hover:border-accent',
      ]}
    >
      {esPedido ? 'Enviar PDF' : esVenta ? 'Ver catálogo' : 'Ver ficha'}
    </span>
  </div>
</a>
