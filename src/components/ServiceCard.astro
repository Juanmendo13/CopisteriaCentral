---
import type { Servicio } from '../data/servicios';
import { servicioEsPedido, servicioHref } from '../data/formatos';
import { precioTarjetaServicio } from '../data/precios';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  servicio: Servicio;
  featured?: boolean;
}

const { servicio, featured: featuredProp } = Astro.props;
const featured = featuredProp ?? servicio.featured ?? false;
const fullWidth = servicio.fullWidth ?? false;
const esPedido = servicioEsPedido(servicio.slug);
const precio = precioTarjetaServicio(servicio.slug);
const esVenta = servicio.slug === 'papeleria';
---

<a
  href={servicioHref(servicio.slug)}
  class:list={[
    'group flex h-full flex-col rounded-xl border border-line bg-white p-5 transition hover:border-brand/30 hover:bg-brand-soft/40',
    fullWidth ? 'sm:col-span-2 lg:col-span-3 sm:p-6' : '',
    featured && 'bg-brand-soft/30',
  ]}
>
  <div class:list={[fullWidth && 'sm:flex sm:items-start sm:justify-between sm:gap-8']}>
    <div class:list={['flex-1', fullWidth && 'min-w-0']}>
      <div class="flex items-start gap-3">
        <ServiceIcon slug={servicio.slug} featured={featured} />
        <div class="min-w-0 flex-1">
          <h3
            class:list={[
              'font-semibold text-ink transition group-hover:text-brand',
              fullWidth ? 'text-xl' : 'text-[15px]',
            ]}
          >
            {servicio.title}
          </h3>
          {
            featured && (
              <span class="mt-1 inline-block text-xs font-medium text-brand">
                {esVenta ? 'Tienda' : 'Especialidad'}
              </span>
            )
          }
        </div>
      </div>
      <p
        class:list={[
          'mt-3 leading-relaxed text-muted',
          fullWidth ? 'text-base max-w-3xl' : 'text-sm',
        ]}
      >
        {servicio.short}
      </p>
      {
        fullWidth && servicio.items.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
            {servicio.items.map((item) => (
              <li class="text-sm text-ink/80">· {item}</li>
            ))}
          </ul>
        )
      }
      {
        !fullWidth && servicio.formats && (
          <p class="mt-3 text-xs text-muted">
            {servicio.formats.join(' · ')}
          </p>
        )
      }
      {
        precio && (
          <p class="mt-3 text-sm font-semibold text-ink">
            {precio.tipo === 'desde' ? (
              <>
                <span class="text-brand">{precio.etiqueta}</span>
                <span class="ml-1 text-xs font-normal text-muted">orientativo</span>
              </>
            ) : (
              <span class="text-sm text-brand">{precio.etiqueta}</span>
            )}
          </p>
        )
      }
    </div>
    <span
      class:list={[
        'mt-4 inline-flex w-fit text-sm font-semibold text-brand transition',
        fullWidth ? 'sm:mt-0 self-start' : 'group-hover:underline',
      ]}
    >
      {esPedido ? 'Enviar PDF →' : esVenta ? 'Ver catálogo →' : 'Ver ficha →'}
    </span>
  </div>
</a>
