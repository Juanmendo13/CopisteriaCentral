---
import { heroAlt, heroImage } from '../data/galeria';

interface Props {
  src?: string;
  alt?: string;
}

const { src = heroImage, alt = heroAlt } = Astro.props;
---

<div class="relative mx-auto w-full max-w-lg lg:max-w-none">
  <div class="absolute -inset-3 rounded-[1.35rem] bg-gradient-to-br from-blue-200/50 via-blue-100/40 to-slate-100/40 blur-sm" aria-hidden="true"></div>
  <div class="relative overflow-hidden rounded-2xl border-4 border-white shadow-2xl shadow-stone-300/40 aspect-[4/3] lg:aspect-[5/4]">
    <img src={src} alt={alt} class="h-full w-full object-cover" loading="eager" decoding="async" />
    <div class="absolute left-4 top-4 rounded-full border border-white/70 bg-white/70 px-3 py-1 text-xs font-bold text-ink shadow-sm backdrop-blur">
      Reina Mercedes · campus
    </div>
  </div>
</div>
