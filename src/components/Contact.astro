---
import TechLeadForm from './TechLeadForm.astro';
---

<section id="contacto" class="scroll-mt-8 border-t border-line bg-void-2 px-5 py-20 sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="relative max-w-3xl overflow-hidden border border-line bg-panel/70 p-6 sm:p-10">
      <div
        class="pointer-events-none absolute -right-8 -top-8 h-40 w-40 rounded-full bg-acid/10 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <p
        class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan"
        data-i18n="contact.kicker"
      >
        Encargos
      </p>
      <h2
        class="font-display mt-3 text-3xl font-extrabold tracking-tight text-fog sm:text-4xl"
        data-i18n="contact.title"
      >
        ¿Qué necesitas montar?
      </h2>
      <p
        class="mt-4 text-base font-medium leading-relaxed text-mist sm:text-lg"
        data-i18n="contact.lead"
      >
        Web/app, API, panel, automatización, TPV/PDA, desktop o IA — si está en mi campo,
        cuéntamelo. TPV base: 200€ pago único; el resto se presupuesta aparte.
      </p>
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-acid">
        TPV/PDA: 200€ one-time · other work: custom quote
      </p>
      <div class="mt-8">
        <TechLeadForm />
      </div>
    </div>
  </div>
</section>
