---
import { site } from '../lib/site';
---

<a href="/" class="flex items-center gap-2.5 shrink-0 group">
  <span class="flex h-9 w-9 items-center justify-center rounded-full border border-accent/80 text-accent font-display italic text-[15px] leading-none">
    {site.shortName}
  </span>
  <span class="flex flex-col leading-none">
    <span class="font-display italic text-[17px] text-white tracking-tight">Central</span>
    <span class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-white/55 group-hover:text-accent transition">
      Copistería
    </span>
  </span>
</a>
