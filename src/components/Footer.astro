---
import { site } from '../lib/site';
---

<footer class="bg-brand-dark text-white mt-4">
  <div class="shop-rule" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8 pb-12">
    <p class="font-display italic text-xl sm:text-2xl text-accent mb-8 max-w-xl leading-snug">
      Te esperamos en el mostrador del Local B.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-10 border-b border-white/10">
      <div>
        <p class="text-sm font-medium text-accent mb-3">Horario</p>
        <ul class="space-y-1.5 text-sm">
          {
            site.hours.map((row) => (
              <li class="flex justify-between gap-4">
                <span class="text-white/50">{row.days}</span>
                <span class="text-white/90">{row.hours}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-medium text-accent mb-3">Local</p>
        <p class="text-sm leading-relaxed text-white/80">
          <span class="block font-semibold text-white mb-1">{site.name}</span>
          {site.addressLine}
          <br />
          {site.postalCity}
          <br />
          <span class="text-white/50">{site.landmark}</span>
        </p>
        <a
          href={site.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex text-sm font-medium text-accent hover:underline"
        >
          Abrir en Google Maps →
        </a>
      </div>

      <div>
        <p class="text-sm font-medium text-accent mb-3">Contacto</p>
        <p class="text-sm text-white/50 mb-4">Presupuesto, archivo o papelería.</p>
        <div class="flex flex-col gap-2">
          <a href="/venta" class="btn-accent inline-flex items-center justify-center px-4 py-2.5 text-sm">
            Ver venta
          </a>
          <a
            href="/pedido"
            class="btn-secondary inline-flex items-center justify-center px-4 py-2.5 text-sm text-white"
          >
            Enviar PDF
          </a>
          <a href={site.phoneHref} class="text-sm text-white/70 hover:text-accent transition text-center py-1">
            {site.phone}
          </a>
        </div>
      </div>
    </div>

    <div class="pt-6 flex flex-col sm:flex-row justify-between gap-3 text-xs text-white/40">
      <div>
        <p>© {new Date().getFullYear()} {site.name}. {site.titular}{site.cif !== 'Pendiente' ? ` · CIF ${site.cif}` : ''}</p>
        {
          site.isPrototype && (
            <p class="mt-1">
              Versión de prueba ·{' '}
              <a href={site.currentWeb} class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">
                Google Maps
              </a>
            </p>
          )
        }
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/aviso-legal" class="hover:text-white/80 transition">Aviso legal</a>
        <a href="/privacidad" class="hover:text-white/80 transition">Privacidad</a>
      </div>
    </div>
  </div>
</footer>
