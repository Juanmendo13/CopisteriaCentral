---
import { site } from '../lib/site';
---

<footer class="border-t border-white/10 bg-brand-dark text-white">
  <div class="max-w-6xl mx-auto px-4 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-10 border-b border-white/15">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-accent mb-4">Horario</p>
        <ul class="space-y-2 text-sm">
          {
            site.hours.map((row) => (
              <li class="flex justify-between gap-4 border-b border-white/10 pb-2 last:border-0">
                <span class="text-white/50">{row.days}</span>
                <span class="text-white font-bold">{row.hours}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-accent mb-4">Local</p>
        <p class="text-sm leading-relaxed">
          <span class="block font-black text-white uppercase tracking-wide">{site.name}</span>
          {site.addressLine}
          <br />
          {site.postalCity}
          <br />
          <span class="text-white/50">{site.landmark}</span>
        </p>
        <a
          href={site.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex text-sm font-bold text-accent hover:underline"
        >
          Abrir en Google Maps →
        </a>
      </div>

      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-accent mb-4">Contacto</p>
        <p class="text-sm text-white/50 mb-4 font-medium">Presupuesto, archivo o papelería.</p>
        <div class="flex flex-col gap-2">
          <a href="/venta" class="btn-accent inline-flex items-center justify-center px-4 py-2.5 text-xs font-black uppercase tracking-wide">
            Ver venta
          </a>
          <a
            href="/pedido"
            class="btn-secondary inline-flex items-center justify-center px-4 py-2.5 text-xs font-black uppercase tracking-wide text-white"
          >
            Enviar PDF
          </a>
          <a
            href={site.phoneHref}
            class="inline-flex items-center justify-center border border-white/25 px-4 py-2.5 text-sm font-bold text-white hover:border-accent hover:text-accent transition"
          >
            {site.phone}
          </a>
          <a
            href={site.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center border border-white/25 px-4 py-2.5 text-sm font-bold text-white hover:border-accent hover:text-accent transition"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row justify-between gap-3 text-xs text-white/40">
      <div>
        <p>© {new Date().getFullYear()} {site.name}. {site.titular}{site.cif !== 'Pendiente' ? ` · CIF ${site.cif}` : ''}</p>
        {
          site.isPrototype && (
            <p class="mt-1">
              Versión de prueba · Ficha en{' '}
              <a href={site.currentWeb} class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">
                Google Maps
              </a>
            </p>
          )
        }
      </div>
      <div class="flex flex-wrap gap-4 font-semibold uppercase tracking-wide">
        <a href="/aviso-legal" class="hover:text-white transition">Aviso legal</a>
        <a href="/privacidad" class="hover:text-white transition">Privacidad</a>
      </div>
    </div>
  </div>
</footer>
