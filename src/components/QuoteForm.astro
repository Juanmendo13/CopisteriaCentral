---
import { servicios } from '../data/servicios';
import { site } from '../lib/site';

interface Props {
  compact?: boolean;
  defaultServicio?: string;
}

const { compact = false, defaultServicio = '' } = Astro.props;

const web3Key =
  process.env.WEB3FORMS_ACCESS_KEY ||
  (import.meta.env.WEB3FORMS_ACCESS_KEY as string | undefined) ||
  '';

const pedidosEmail =
  process.env.PEDIDOS_EMAIL ||
  (import.meta.env.PEDIDOS_EMAIL as string | undefined) ||
  site.inboxEmail;

const inputClass = 'field-stamp';
---

<form
  id="quote-form"
  class="space-y-4"
  data-web3-key={web3Key}
  data-to-email={pedidosEmail}
  novalidate
>
  <div class:list={['grid gap-4', compact ? 'sm:grid-cols-1' : 'sm:grid-cols-2']}>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Nombre
      <input class:list={[inputClass, 'mt-1.5 normal-case tracking-normal font-semibold']} type="text" name="nombre" autocomplete="name" required minlength="2" maxlength="80" />
    </label>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Email
      <input class:list={[inputClass, 'mt-1.5 normal-case tracking-normal font-semibold']} type="email" name="email" autocomplete="email" required />
    </label>
  </div>

  <div class:list={['grid gap-4', compact ? 'sm:grid-cols-1' : 'sm:grid-cols-2']}>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Teléfono
      <input class:list={[inputClass, 'mt-1.5 normal-case tracking-normal font-semibold']} type="tel" name="telefono" autocomplete="tel" required />
    </label>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Servicio
      <select class:list={[inputClass, 'mt-1.5 normal-case tracking-normal font-semibold']} name="servicio">
        <option value="">Selecciona (opcional)</option>
        {servicios.map((s) => (
          <option value={s.title} selected={s.slug === defaultServicio}>
            {s.title}
          </option>
        ))}
      </select>
    </label>
  </div>

  <div class:list={['grid gap-4', compact ? 'sm:grid-cols-1' : 'sm:grid-cols-2']}>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Formato / medida
      <input class:list={[inputClass, 'mt-1.5 normal-case tracking-normal font-semibold']} type="text" name="formato" placeholder="A0, A3, 70×100…" maxlength="80" />
    </label>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Cantidad
      <input class:list={[inputClass, 'mt-1.5 normal-case tracking-normal font-semibold']} type="number" name="cantidad" placeholder="1" min="1" max="9999" step="1" />
    </label>
  </div>

  <label class="block text-sm font-black uppercase tracking-wide text-brand">
    Detalles del trabajo
    <textarea
      class:list={[inputClass, 'mt-1.5 min-h-28 normal-case tracking-normal font-semibold']}
      name="mensaje"
      maxlength="2000"
      placeholder="Color o B/N, papel, fecha de entrega, montaje…"
      required></textarea>
  </label>

  <label class="flex items-start gap-2.5 text-sm font-semibold text-muted">
    <input type="checkbox" name="privacidad" required class="mt-1 accent-[#002d62]" />
    <span>
      He leído y acepto la <a href="/privacidad" class="text-brand font-black underline decoration-2 underline-offset-2">política de privacidad</a>.
    </span>
  </label>

  <p id="quote-error" class="alert-stamp alert-stamp-error hidden" role="alert"></p>
  <p id="quote-ok" class="alert-stamp alert-stamp-ok hidden" role="status">
    Presupuesto enviado. Te responderemos por email o teléfono — con cariño de barrio.
  </p>

  <button
    type="submit"
    class="btn-navy inline-flex w-full sm:w-auto justify-center px-6 py-3 text-sm disabled:opacity-60"
  >
    Enviar presupuesto
  </button>
</form>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('quote-error');
  const okEl = document.getElementById('quote-ok');

  function showError(message: string) {
    if (!errorEl || !okEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    okEl.classList.add('hidden');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const telefono = String(data.get('telefono') ?? '').trim();
    const servicio = String(data.get('servicio') ?? '').trim();
    const formato = String(data.get('formato') ?? '').trim();
    const cantidad = String(data.get('cantidad') ?? '').trim();
    const mensaje = String(data.get('mensaje') ?? '').trim();
    const privacidad = data.get('privacidad');

    if (nombre.length < 2) return showError('Indica tu nombre.');
    if (!email.includes('@')) return showError('Indica un email válido.');
    if (telefono.replace(/\D/g, '').length < 9) return showError('Indica un teléfono válido.');
    if (mensaje.length < 8) return showError('Describe el trabajo con un poco más de detalle.');
    if (!privacidad) return showError('Debes aceptar la política de privacidad.');

    const accessKey = form.dataset.web3Key;
    if (!accessKey) {
      showError('Falta WEB3FORMS_ACCESS_KEY. Configúrala en .env.local o en Vercel.');
      return;
    }

    const lines = [
      `Nuevo presupuesto · Copistería Central`,
      `Cliente: ${nombre}`,
      `Email: ${email}`,
      `Teléfono: ${telefono}`,
      servicio ? `Servicio: ${servicio}` : '',
      formato ? `Formato: ${formato}` : '',
      cantidad ? `Cantidad: ${cantidad}` : '',
      '',
      mensaje,
    ]
      .filter((line) => line !== undefined)
      .join('\n');

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';
    }
    errorEl?.classList.add('hidden');
    okEl?.classList.add('hidden');

    try {
      const web3 = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: `Presupuesto · ${nombre}${servicio ? ` · ${servicio}` : ''}`,
          from_name: nombre,
          name: nombre,
          email,
          phone: telefono,
          message: lines,
        }),
      });
      const result = (await web3.json().catch(() => ({}))) as {
        success?: boolean;
        message?: string;
      };

      if (!web3.ok || !result.success) {
        showError(result.message || 'No se pudo enviar. Prueba por teléfono o email.');
        return;
      }

      form.reset();
      okEl?.classList.remove('hidden');
    } catch {
      showError('No se pudo enviar. Revisa la conexión o llama al local.');
    } finally {
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar presupuesto';
      }
    }
  });
</script>
