---
import { site } from '../lib/site';
---

<section class="relative z-10 px-4 -mt-10 pb-4">
  <div class="max-w-6xl mx-auto grid sm:grid-cols-3 gap-4">
    <div class="flex items-start gap-4 rounded-2xl border border-line bg-white p-5">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-dark text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
      </span>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Dónde</p>
        <p class="mt-1 text-sm font-semibold text-ink leading-snug">{site.landmark}</p>
        <p class="text-sm text-slate-500">{site.postalCity}</p>
      </div>
    </div>

    <div class="flex items-start gap-4 rounded-2xl border border-line bg-white p-5">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-dark text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </span>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Horario</p>
        <p class="mt-1 text-sm font-semibold text-ink">L–J 9:00 – 20:30</p>
        <p class="text-sm text-slate-500">Sáb 9:30 – 13:30</p>
      </div>
    </div>

    <div class="flex items-start gap-4 rounded-2xl border border-line bg-white p-5">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-dark text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
      </span>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Teléfono</p>
        <p class="mt-1 text-sm font-semibold text-ink">{site.phone}</p>
        <a href="/venta" class="mt-1 inline-flex text-sm font-medium text-brand hover:text-brand-dark">Ver venta →</a>
      </div>
    </div>
  </div>
</section>
