---
import { site } from '../lib/site';
---

{
  site.isPrototype && (
    <div class="bg-accent-soft px-4 py-2 text-center text-xs leading-relaxed text-brand">
      <span class="font-semibold">Versión de prueba</span>
      <span class="hidden sm:inline"> — </span>
      <span class="block sm:inline">Propuesta de web, no es el sitio oficial.</span>
      {' '}
      <a href={site.currentWeb} class="font-semibold underline underline-offset-2 hover:opacity-80" target="_blank" rel="noopener noreferrer">
        Ver en Google Maps
      </a>
    </div>
  )
}
