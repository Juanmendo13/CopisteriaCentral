---
import { site } from '../lib/site';
---

{
  site.isPrototype && (
    <div class="border-b border-accent/50 bg-accent px-4 py-2 text-center text-xs leading-relaxed text-brand">
      <span class="font-black uppercase tracking-wide">Versión de prueba</span>
      <span class="hidden sm:inline"> — </span>
      <span class="block sm:inline font-medium">Propuesta de web, no es el sitio oficial.</span>
      <span class="hidden md:inline font-medium"> Los formularios son de demostración.</span>
      {' '}
      <a href={site.currentWeb} class="font-black underline underline-offset-2 hover:opacity-80" target="_blank" rel="noopener noreferrer">
        Ver en Google Maps
      </a>
    </div>
  )
}
