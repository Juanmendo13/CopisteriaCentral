---
import { formatEuro, type VentaItem } from '../data/venta';
import { site } from '../lib/site';
import type { CatalogProduct } from '../lib/venta-catalog';

interface Props {
  grupos: { categoria: string; items: CatalogProduct[] }[];
}

const { grupos } = Astro.props;

const catalogoJson = JSON.stringify(
  grupos.flatMap((g) => g.items).map((item: VentaItem) => ({
    id: item.id,
    nombre: item.nombre,
    precio: item.precio,
    unidad: item.unidad,
    modo: item.modo,
    image: item.image,
  })),
);

const inputClass = 'field-stamp !py-2 !px-2.5 min-h-11 text-sm';

function stockLabel(item: CatalogProduct): string | null {
  if (item.stock === undefined) return null;
  if (item.stock === null) return 'Consultar stock';
  if (item.stock === 0) return 'Sin stock';
  return `Stock: ${item.stock}`;
}
---

<div class="grid lg:grid-cols-[1fr_19rem] gap-6 lg:gap-7 items-start" id="venta-app" data-catalogo={catalogoJson}>
  <div class="space-y-8 sm:space-y-12" id="venta-catalogo">
    {
      grupos.map((grupo) => {
        const catId = grupo.categoria.toLowerCase().replace(/[^a-z0-9]+/gi, '-');
        return (
          <section id={catId} class="scroll-mt-32" data-venta-section={catId}>
            <h2 class="font-display text-lg sm:text-2xl text-brand mb-3 sm:mb-5">{grupo.categoria}</h2>
            <div class="grid grid-cols-2 gap-2.5 sm:gap-4">
              {grupo.items.map((item) => (
                <article
                  class="rounded-sm border-2 sm:border-[2.5px] border-brand bg-white overflow-hidden flex flex-col shadow-[2px_2px_0_rgba(0,45,98,0.15)] sm:shadow-[3px_3px_0_rgba(0,45,98,0.15)] hover:shadow-[5px_5px_0_rgba(0,45,98,0.2)] hover:-translate-y-0.5 transition"
                  data-venta-product
                  data-haystack={`${item.nombre} ${item.descripcion} ${item.categoria}`}
                >
                  <div class="aspect-[3/2] max-h-28 sm:max-h-none sm:aspect-[4/3] bg-paper-deep overflow-hidden border-b-2 border-brand">
                    <img
                      src={item.image}
                      alt={item.nombre}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </div>
                  <div class="p-2.5 sm:p-4 flex flex-col gap-2 sm:gap-3 flex-1">
                    <div class="flex-1 min-w-0">
                      <h3 class="font-extrabold text-ink leading-snug text-sm sm:text-base">{item.nombre}</h3>
                      <p class="mt-0.5 sm:mt-1 text-xs sm:text-sm text-muted leading-snug line-clamp-2 sm:leading-relaxed sm:line-clamp-none">
                        {item.descripcion}
                      </p>
                      <p class="mt-1.5 sm:mt-2 text-sm sm:text-base font-black text-brand">
                        {item.precio == null ? (
                          <span class="text-xs sm:text-sm font-bold text-coral">Consultar</span>
                        ) : (
                          <>
                            {formatEuro(item.precio)}
                            <span class="font-semibold text-muted text-xs sm:text-sm"> / {item.unidad}</span>
                          </>
                        )}
                      </p>
                      {
                        stockLabel(item) && (
                          <p class="mt-1 text-[11px] sm:text-xs font-bold text-muted uppercase tracking-wide">
                            {stockLabel(item)}
                          </p>
                        )
                      }
                    </div>
                    <div class="flex items-stretch gap-1.5 sm:gap-2">
                      <label class="sr-only" for={`qty-${item.id}`}>
                        Cantidad {item.nombre}
                      </label>
                      <input
                        id={`qty-${item.id}`}
                        type="number"
                        min="1"
                        max="5000"
                        value="1"
                        class="w-12 sm:w-20 min-h-11 rounded-sm border-2 border-brand px-1.5 sm:px-2 py-2 text-sm font-semibold"
                        data-qty-for={item.id}
                      />
                      <button
                        type="button"
                        class="btn-accent flex-1 min-h-11 px-2 sm:px-3 py-2 text-xs sm:text-sm"
                        data-add={item.id}
                      >
                        Añadir
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }

    <p
      id="venta-search-empty"
      class="hidden rounded-sm border-[2.5px] border-dashed border-brand bg-white/80 px-5 py-8 text-center text-brand font-semibold leading-relaxed shadow-[3px_3px_0_rgba(0,45,98,0.12)]"
      role="status"
      aria-live="polite"
    >
      No hay nada con ese nombre en el mostrador.
      <span class="block mt-1 text-sm font-medium text-muted">Prueba otra palabra o borra la búsqueda.</span>
    </p>
  </div>

  <aside
    id="lista-compra"
    class="lista-compra lg:sticky lg:top-28 lg:self-start lg:max-h-[calc(100vh-8rem)] lg:overflow-y-auto scroll-mt-36 rounded-sm border-[2.5px] border-brand bg-accent-soft p-4 shadow-[4px_4px_0_rgba(0,45,98,0.2)]"
  >
    <div class="lista-compra-head sticky z-20 -mx-4 -mt-4 mb-3 px-4 pt-3.5 pb-2.5 bg-accent-soft border-b border-brand/15 lg:static lg:z-auto lg:mx-0 lg:mt-0 lg:mb-3 lg:px-0 lg:pt-0 lg:pb-0 lg:border-0">
      <div class="flex items-center justify-between gap-2">
        <h2 class="font-display text-base font-bold text-ink">Lista de compra</h2>
        <span id="cart-count" class="rounded-md bg-brand-dark text-accent px-2 py-0.5 text-[11px] font-bold tabular-nums">0</span>
      </div>
      <div class="mt-1.5 flex justify-between items-baseline gap-2 text-xs font-black text-ink">
        <span>Subtotal orientativo</span>
        <span id="cart-subtotal" class="tabular-nums">{formatEuro(0)}</span>
      </div>
      <p class="mt-0.5 text-[11px] text-muted font-medium leading-snug">Precios orientativos. Se confirman en el local.</p>
    </div>

    <ul id="cart-lines" class="space-y-2.5 text-sm max-h-56 overflow-y-auto"></ul>
    <p id="cart-empty" class="text-xs text-muted font-medium">Aún no has añadido nada.</p>

    <form id="cart-checkout" class="mt-4 space-y-2.5" novalidate>
      <label class="block text-xs font-black uppercase tracking-wide text-brand">
        Nombre
        <input class:list={[inputClass, 'mt-1 normal-case tracking-normal font-semibold']} type="text" name="nombre" required minlength="2" maxlength="80" autocomplete="name" />
      </label>
      <label class="block text-xs font-black uppercase tracking-wide text-brand">
        Email
        <input class:list={[inputClass, 'mt-1 normal-case tracking-normal font-semibold']} type="email" name="email" required autocomplete="email" />
      </label>
      <label class="block text-xs font-black uppercase tracking-wide text-brand">
        Teléfono
        <input class:list={[inputClass, 'mt-1 normal-case tracking-normal font-semibold']} type="tel" name="telefono" required autocomplete="tel" />
      </label>
      <label class="block text-xs font-black uppercase tracking-wide text-brand">
        Notas (opcional)
        <textarea class:list={[inputClass, 'mt-1 min-h-16 normal-case tracking-normal font-semibold']} name="notas" maxlength="1000" placeholder="Cuándo pasas a recoger…"></textarea>
      </label>
      <button type="submit" id="cart-submit" class="btn-navy w-full min-h-11 px-3 py-2.5 text-xs">
        Solicitar reserva
      </button>
      <p class="text-[11px] text-muted font-medium leading-relaxed">
        No es un cobro online: confirmamos stock y precio en el local ({site.phone}).
        {
          site.isPrototype && (
            <>
              {' '}
              Aviso a la tienda: {site.inboxEmail}
            </>
          )
        }
      </p>
      <p id="cart-status" class="text-xs hidden font-semibold" role="status"></p>
    </form>
  </aside>
</div>

<script>
  import { sendShopWeb3Forms } from '../lib/client-web3forms';
  import { shopNotifyClientStatus } from '../lib/shop-notify-ui';

  type CartLine = { id: string; cantidad: number };
  type CatalogItem = {
    id: string;
    nombre: string;
    precio: number | null;
    unidad: string;
    modo: 'fijo' | 'consultar';
    image?: string;
  };

  const STORAGE_KEY = 'cc-venta-carrito-v1';
  const root = document.getElementById('venta-app');
  const catalogo: CatalogItem[] = JSON.parse(root?.dataset.catalogo || '[]');
  const byId = Object.fromEntries(catalogo.map((i) => [i.id, i]));

  const linesEl = document.getElementById('cart-lines');
  const emptyEl = document.getElementById('cart-empty');
  const countEl = document.getElementById('cart-count');
  const subtotalEl = document.getElementById('cart-subtotal');
  const form = document.getElementById('cart-checkout') as HTMLFormElement | null;
  const submitBtn = document.getElementById('cart-submit') as HTMLButtonElement | null;
  const statusEl = document.getElementById('cart-status');

  function load(): CartLine[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw) as CartLine[];
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((l) => byId[l.id] && Number.isInteger(l.cantidad) && l.cantidad > 0);
    } catch {
      return [];
    }
  }

  function save(lines: CartLine[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(lines));
  }

  function euro(n: number) {
    return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(n);
  }

  let cart = load();

  function render() {
    if (!linesEl || !emptyEl || !countEl || !subtotalEl) return;

    const totalQty = cart.reduce((s, l) => s + l.cantidad, 0);
    countEl.textContent = String(totalQty);

    linesEl.innerHTML = '';
    let subtotal = 0;

    if (cart.length === 0) {
      emptyEl.classList.remove('hidden');
    } else {
      emptyEl.classList.add('hidden');
      for (const line of cart) {
        const item = byId[line.id];
        if (!item) continue;
        const li = document.createElement('li');
        li.className = 'rounded-xl border border-line bg-white p-3';

        let priceLabel = 'Consultar';
        if (item.modo === 'fijo' && item.precio != null) {
          const lineTotal = item.precio * line.cantidad;
          subtotal += lineTotal;
          priceLabel = euro(lineTotal);
        }

        li.innerHTML = `
          <div class="flex gap-3">
            ${
              item.image
                ? `<img src="${item.image}" alt="" class="h-12 w-12 rounded-lg object-cover shrink-0 bg-slate-100" loading="lazy" />`
                : ''
            }
            <div class="flex-1 min-w-0">
              <div class="flex justify-between gap-2">
                <div>
                  <p class="font-semibold text-ink leading-snug">${item.nombre}</p>
                  <p class="text-xs text-slate-500">${line.cantidad} × ${
                    item.precio != null ? euro(item.precio) : 'a consultar'
                  }</p>
                </div>
                <p class="font-bold text-ink shrink-0">${priceLabel}</p>
              </div>
              <div class="mt-2 flex gap-2">
                <button type="button" class="rounded-lg border border-slate-200 px-2 py-1 text-xs font-semibold" data-dec="${item.id}">−</button>
                <button type="button" class="rounded-lg border border-slate-200 px-2 py-1 text-xs font-semibold" data-inc="${item.id}">+</button>
                <button type="button" class="rounded-lg border border-slate-200 px-2 py-1 text-xs font-semibold text-red-700 ml-auto" data-rm="${item.id}">Quitar</button>
              </div>
            </div>
          </div>
        `;
        linesEl.appendChild(li);
      }
    }

    subtotalEl.textContent = euro(subtotal);
    save(cart);

    window.dispatchEvent(
      new CustomEvent('cc-venta-cart', {
        detail: { qty: totalQty, subtotal, formatted: euro(subtotal) },
      }),
    );
  }

  function add(id: string, qty: number) {
    const existing = cart.find((l) => l.id === id);
    if (existing) existing.cantidad = Math.min(5000, existing.cantidad + qty);
    else cart.push({ id, cantidad: qty });
    render();
  }

  root?.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.add!;
      const input = root.querySelector<HTMLInputElement>(`[data-qty-for="${id}"]`);
      const qty = Math.max(1, Math.min(5000, Number(input?.value || 1) || 1));
      add(id, qty);
    });
  });

  linesEl?.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const dec = t.closest<HTMLElement>('[data-dec]')?.getAttribute('data-dec');
    const inc = t.closest<HTMLElement>('[data-inc]')?.getAttribute('data-inc');
    const rm = t.closest<HTMLElement>('[data-rm]')?.getAttribute('data-rm');
    if (dec) {
      const line = cart.find((l) => l.id === dec);
      if (!line) return;
      line.cantidad -= 1;
      if (line.cantidad < 1) cart = cart.filter((l) => l.id !== dec);
      render();
    }
    if (inc) {
      const line = cart.find((l) => l.id === inc);
      if (!line) return;
      line.cantidad = Math.min(5000, line.cantidad + 1);
      render();
    }
    if (rm) {
      cart = cart.filter((l) => l.id !== rm);
      render();
    }
  });

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!statusEl || !submitBtn) return;
    if (cart.length === 0) {
      statusEl.className = 'text-sm text-red-700';
      statusEl.textContent = 'Añade al menos un producto a la lista.';
      statusEl.classList.remove('hidden');
      return;
    }

    const fd = new FormData(form);
    const payload = {
      nombre: String(fd.get('nombre') || ''),
      email: String(fd.get('email') || ''),
      telefono: String(fd.get('telefono') || ''),
      notas: String(fd.get('notas') || ''),
      lineas: cart,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';
    statusEl.classList.add('hidden');

    try {
      const res = await fetch('/api/presupuesto-carrito', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.ok || !data.web3forms) throw new Error(data.error || 'No se pudo enviar.');
      const gmail = await sendShopWeb3Forms(data.web3forms);
      const status = shopNotifyClientStatus(gmail.ok, data, 'venta');
      if (!status.ok && !status.partial) throw new Error(status.text);
      statusEl.className = status.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-800';
      statusEl.textContent = status.text;
      statusEl.classList.remove('hidden');
      cart = [];
      render();
      form.reset();
    } catch (err) {
      statusEl.className = 'text-sm text-red-700';
      statusEl.textContent = err instanceof Error ? err.message : 'Error al enviar.';
      statusEl.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Solicitar reserva / presupuesto';
    }
  });

  render();

  /* —— Búsqueda en catálogo —— */
  const searchInput = document.getElementById('venta-search') as HTMLInputElement | null;
  const searchClear = document.getElementById('venta-search-clear') as HTMLButtonElement | null;
  const searchEmpty = document.getElementById('venta-search-empty');
  const products = Array.from(document.querySelectorAll<HTMLElement>('[data-venta-product]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-venta-section]'));
  const catLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-venta-cat]'));

  function fold(s: string) {
    return s
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();
  }

  function applySearch(raw: string) {
    const q = fold(raw);
    const tokens = q.split(/\s+/).filter(Boolean);
    let visibleCount = 0;

    for (const product of products) {
      const hay = fold(product.dataset.haystack || '');
      const match = tokens.length === 0 || tokens.every((t) => hay.includes(t));
      product.classList.toggle('hidden', !match);
      if (match) visibleCount += 1;
    }

    for (const section of sections) {
      const anyVisible = section.querySelectorAll('[data-venta-product]:not(.hidden)').length > 0;
      section.classList.toggle('hidden', !anyVisible);
      const catId = section.dataset.ventaSection;
      if (catId) {
        for (const link of catLinks) {
          if (link.dataset.ventaCat === catId) {
            link.classList.toggle('hidden', !anyVisible);
          }
        }
      }
    }

    const searching = tokens.length > 0;
    searchEmpty?.classList.toggle('hidden', !(searching && visibleCount === 0));
    searchClear?.classList.toggle('hidden', !raw.trim());
  }

  searchInput?.addEventListener('input', () => applySearch(searchInput.value));
  searchClear?.addEventListener('click', () => {
    if (!searchInput) return;
    searchInput.value = '';
    applySearch('');
    searchInput.focus();
  });
</script>
