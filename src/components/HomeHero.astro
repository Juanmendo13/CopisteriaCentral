---
import { site } from '../lib/site';
import PrototypeBanner from './PrototypeBanner.astro';
import { heroAlt, heroImage } from '../data/galeria';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/venta', label: 'Venta' },
  { href: '/precios', label: 'Precios' },
  { href: '/pedido', label: 'Enviar archivo' },
  { href: '/contacto', label: 'Contacto' },
];

const current = Astro.url.pathname;
const benefits = [
  'Abre pronto, cierra tarde',
  'Precios de barrio',
  'Recogida en mostrador',
];
---

<header class:list={['site-header w-full', site.isPrototype && 'has-banner']}>
  <PrototypeBanner />
  <!-- Barra de navegación edge-to-edge (no flotante) -->
  <div class="bg-brand border-b-2 border-accent">
    <div class="max-w-6xl mx-auto px-4 h-14 md:h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 shrink-0">
        <span class="flex h-9 w-9 items-center justify-center bg-accent text-brand text-xs font-black tracking-tight">
          {site.shortName}
        </span>
        <span class="leading-none hidden xs:block sm:block">
          <span class="block text-[13px] font-black uppercase tracking-[0.08em] text-white">Central</span>
          <span class="block text-[10px] font-medium tracking-wide text-white/50 mt-0.5">Copistería</span>
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-0 text-[13px] font-semibold uppercase tracking-[0.06em]">
        {
          links.map((link) => {
            const active =
              link.href === '/'
                ? current === '/'
                : link.href === '/servicios'
                  ? current === '/servicios' || current.startsWith('/servicio/')
                  : current === link.href || current.startsWith(`${link.href}/`);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-3 py-5 border-b-2 -mb-[2px] transition',
                  active
                    ? 'border-accent text-accent'
                    : 'border-transparent text-white/70 hover:text-white hover:border-white/30',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-2">
        <a href="/pedido" class="btn-primary hidden sm:inline-flex items-center px-4 py-2 text-xs font-black uppercase tracking-wide">
          Enviar PDF
        </a>
        <button
          id="hero-menu-toggle"
          class="flex lg:hidden flex-col justify-center items-center w-10 h-10 border border-white/25 text-white p-2 gap-1.5"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="hero-mobile-menu"
        >
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 hero-menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-opacity duration-300 hero-menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 hero-menu-line"></span>
        </button>
      </div>
    </div>

    <div id="hero-mobile-menu" class="lg:hidden max-h-0 overflow-hidden bg-brand-dark border-t border-white/10 transition-all duration-300">
      <nav class="flex flex-col px-4 py-3 gap-0 text-sm font-semibold uppercase tracking-wide">
        {
          links.map((link) => (
            <a href={link.href} class="hero-mobile-link px-3 py-3 border-b border-white/10 text-white/85 hover:text-accent transition">
              {link.label}
            </a>
          ))
        }
        <a href="/pedido" class="hero-mobile-link btn-primary mt-3 mb-2 inline-flex justify-center px-3 py-2.5 text-xs font-black uppercase">
          Enviar PDF
        </a>
      </nav>
    </div>
  </div>
</header>

<!-- Split asimétrico: texto ~42% / imagen ~58% -->
<section class="relative flex flex-col lg:flex-row lg:min-h-[78vh]">
  <div class="relative z-10 flex flex-col justify-center bg-brand text-white lg:w-[42%] px-5 sm:px-8 lg:px-10 xl:px-14 py-12 lg:py-16 border-b lg:border-b-0 lg:border-r border-white/10">
    <p class="text-[11px] font-bold uppercase tracking-[0.32em] text-accent mb-5">
      Av. Reina Mercedes 41 · Sevilla
    </p>
    <h1 class="font-display text-[2.35rem] sm:text-5xl xl:text-[3.4rem] font-black leading-[0.98] tracking-[-0.03em]">
      Impresión y papelería<br class="hidden sm:block" /> junto al campus
    </h1>
    <p class="mt-6 text-[15px] md:text-base text-white/70 leading-relaxed max-w-md font-medium">
      {site.name}: fotocopias, color, encuadernación, plastificados y material de escritorio. Abierta a horas de estudio — sin rodeos.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/pedido" class="btn-primary inline-flex items-center px-6 py-3.5 text-sm font-black uppercase tracking-wide">
        Enviar PDF
      </a>
      <a href="/venta" class="btn-secondary inline-flex items-center px-6 py-3.5 text-sm font-black uppercase tracking-wide text-white">
        Catálogo venta
      </a>
    </div>

    <!-- Beneficios en línea (no cápsulas) -->
    <ul class="mt-8 space-y-2.5 border-t border-white/15 pt-6">
      {
        benefits.map((b) => (
          <li class="flex items-center gap-3 text-sm font-semibold text-white/85">
            <span class="h-1.5 w-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
            {b}
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-sm text-white/45">
      Tel. <a href={site.phoneHref} class="font-bold text-accent hover:underline">{site.phone}</a>
    </p>
  </div>

  <div class="relative lg:w-[58%] min-h-[38vh] sm:min-h-[48vh] lg:min-h-auto">
    <img
      src={heroImage}
      alt={heroAlt}
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-brand to-transparent pointer-events-none lg:block hidden" aria-hidden="true"></div>
  </div>
</section>

<script>
  const menuToggle = document.getElementById('hero-menu-toggle');
  const mobileMenu = document.getElementById('hero-mobile-menu');
  const mobileLinks = document.querySelectorAll('.hero-mobile-link');
  const lines = menuToggle?.querySelectorAll('.hero-menu-line');

  function setOpen(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      mobileMenu.classList.remove('max-h-0');
      mobileMenu.classList.add('max-h-[28rem]');
      if (lines && lines.length === 3) {
        lines[0].classList.add('translate-y-2', 'rotate-45');
        lines[1].classList.add('opacity-0');
        lines[2].classList.add('-translate-y-2', '-rotate-45');
      }
    } else {
      mobileMenu.classList.remove('max-h-[28rem]');
      mobileMenu.classList.add('max-h-0');
      if (lines && lines.length === 3) {
        lines[0].classList.remove('translate-y-2', 'rotate-45');
        lines[1].classList.remove('opacity-0');
        lines[2].classList.remove('-translate-y-2', '-rotate-45');
      }
    }
  }

  menuToggle?.addEventListener('click', () => {
    setOpen(mobileMenu?.classList.contains('max-h-0') ?? false);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
