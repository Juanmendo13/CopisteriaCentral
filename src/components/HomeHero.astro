---
import { site } from '../lib/site';
import PrototypeBanner from './PrototypeBanner.astro';
import ShopMark from './ShopMark.astro';
import { heroAlt, heroImage } from '../data/galeria';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/venta', label: 'Venta' },
  { href: '/precios', label: 'Precios' },
  { href: '/pedido', label: 'Enviar archivo' },
  { href: '/contacto', label: 'Contacto' },
];

const current = Astro.url.pathname;
---

<header class:list={['site-header w-full', site.isPrototype && 'has-banner']}>
  <PrototypeBanner />
  <div class="bg-brand">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 h-14 md:h-[3.75rem] flex items-center justify-between gap-4">
      <ShopMark />

      <nav class="hidden lg:flex items-center gap-1 text-sm font-medium">
        {
          links.map((link) => {
            const active =
              link.href === '/'
                ? current === '/'
                : link.href === '/servicios'
                  ? current === '/servicios' || current.startsWith('/servicio/')
                  : current === link.href || current.startsWith(`${link.href}/`);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-3 py-1.5 rounded-md transition',
                  active ? 'text-accent' : 'text-white/75 hover:text-white',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-2">
        <a href="/pedido" class="btn-primary hidden sm:inline-flex items-center px-4 py-2 text-sm">
          Enviar PDF
        </a>
        <button
          id="hero-menu-toggle"
          class="flex lg:hidden flex-col justify-center items-center w-10 h-10 rounded-md text-white p-2 gap-1.5"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="hero-mobile-menu"
        >
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 hero-menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-opacity duration-300 hero-menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 hero-menu-line"></span>
        </button>
      </div>
    </div>

    <div id="hero-mobile-menu" class="lg:hidden max-h-0 overflow-hidden bg-brand-dark transition-all duration-300">
      <nav class="flex flex-col px-5 py-3 gap-0.5 text-sm font-medium">
        {
          links.map((link) => (
            <a href={link.href} class="hero-mobile-link px-3 py-2.5 rounded-md text-white/85 hover:bg-white/10 hover:text-accent transition">
              {link.label}
            </a>
          ))
        }
        <a href="/pedido" class="hero-mobile-link btn-primary mt-2 mb-2 inline-flex justify-center px-3 py-2.5 text-sm">
          Enviar PDF
        </a>
      </nav>
    </div>
  </div>
  <div class="shop-rule" aria-hidden="true"></div>
</header>

<section class="relative flex flex-col lg:flex-row lg:min-h-[74vh]">
  <div class="relative z-10 flex flex-col justify-center bg-brand text-white lg:w-[46%] px-5 sm:px-8 lg:px-12 py-14 lg:py-20">
    <p class="stamp text-accent mb-5 w-fit">Local B · Reina Mercedes</p>
    <h1 class="font-display text-[2.35rem] sm:text-[2.7rem] xl:text-[3.15rem] font-semibold leading-[1.08] tracking-tight">
      La copistería de la avenida, <span class="marker text-white">la de siempre</span>
    </h1>
    <p class="mt-5 text-base text-white/75 leading-relaxed max-w-md">
      Cruzas del campus y ya estás en el mostrador. Fotocopias, color, espiral, plastificado y el boli que se te olvidó antes de clase.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/pedido" class="btn-primary inline-flex items-center px-5 py-3 text-sm">
        Traer el PDF
      </a>
      <a href="/venta" class="btn-secondary inline-flex items-center px-5 py-3 text-sm text-white">
        Papelería del local
      </a>
    </div>

    <p class="mt-8 font-display italic text-[15px] text-accent/90 leading-relaxed max-w-sm">
      Abrimos pronto, cerramos tarde y el precio se dice en el mostrador.
    </p>

    <p class="mt-4 text-sm text-white/55">
      Si tienes prisa, llama:
      <a href={site.phoneHref} class="font-semibold text-accent hover:underline">{site.phone}</a>
    </p>
  </div>

  <div class="relative lg:w-[54%] min-h-[40vh] sm:min-h-[48vh] lg:min-h-auto bg-paper p-3 sm:p-4 lg:p-5">
    <img
      src={heroImage}
      alt={heroAlt}
      class="absolute inset-3 sm:inset-4 lg:inset-5 h-[calc(100%-1.5rem)] sm:h-[calc(100%-2rem)] lg:h-[calc(100%-2.5rem)] w-[calc(100%-1.5rem)] sm:w-[calc(100%-2rem)] lg:w-[calc(100%-2.5rem)] object-cover"
      loading="eager"
      decoding="async"
    />
    <p class="counter-note absolute bottom-6 left-6 right-6 sm:right-auto sm:max-w-xs px-4 py-3 text-sm text-ink leading-relaxed rotate-[-0.6deg]">
      <span class="block font-display italic text-brand mb-1">Nota del mostrador</span>
      Si vienes con el archivo en el móvil, lo abrimos aquí y te decimos si sale bien.
    </p>
  </div>
</section>

<script>
  const menuToggle = document.getElementById('hero-menu-toggle');
  const mobileMenu = document.getElementById('hero-mobile-menu');
  const mobileLinks = document.querySelectorAll('.hero-mobile-link');
  const lines = menuToggle?.querySelectorAll('.hero-menu-line');

  function setOpen(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      mobileMenu.classList.remove('max-h-0');
      mobileMenu.classList.add('max-h-[28rem]');
      if (lines && lines.length === 3) {
        lines[0].classList.add('translate-y-2', 'rotate-45');
        lines[1].classList.add('opacity-0');
        lines[2].classList.add('-translate-y-2', '-rotate-45');
      }
    } else {
      mobileMenu.classList.remove('max-h-[28rem]');
      mobileMenu.classList.add('max-h-0');
      if (lines && lines.length === 3) {
        lines[0].classList.remove('translate-y-2', 'rotate-45');
        lines[1].classList.remove('opacity-0');
        lines[2].classList.remove('-translate-y-2', '-rotate-45');
      }
    }
  }

  menuToggle?.addEventListener('click', () => {
    setOpen(mobileMenu?.classList.contains('max-h-0') ?? false);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
