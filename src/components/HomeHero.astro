---
import { site } from '../lib/site';
import PrototypeBanner from './PrototypeBanner.astro';
import Doodle from './Doodle.astro';
import DoodleDecor from './DoodleDecor.astro';
import { heroAlt } from '../data/galeria';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/venta', label: 'Venta' },
  { href: '/precios', label: 'Precios' },
  { href: '/pedido', label: 'Enviar archivo' },
  { href: '/contacto', label: 'Contacto' },
];

const current = Astro.url.pathname;
---

<header class:list={['site-header w-full', site.isPrototype && 'has-banner']}>
  <PrototypeBanner />
  <div class="bg-brand border-b-[6px] border-accent">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 h-14 md:h-[3.85rem] flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <span class="stamp-mark stamp-ink h-10 w-10 text-sm">{site.shortName}</span>
        <span class="font-display text-[15px] sm:text-[17px] text-white leading-none tracking-tight">
          Copistería Central
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-1 text-sm font-extrabold uppercase tracking-wide">
        {
          links.map((link) => {
            const active =
              link.href === '/'
                ? current === '/'
                : link.href === '/servicios'
                  ? current === '/servicios' || current.startsWith('/servicio/')
                  : current === link.href || current.startsWith(`${link.href}/`);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-2.5 py-1.5 transition',
                  active ? 'nav-active' : 'text-white/80 hover:text-accent',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-2">
        <a href="/pedido" class="btn-primary hidden sm:inline-flex items-center px-4 py-2 text-xs">
          Enviar PDF
        </a>
        <button
          id="hero-menu-toggle"
          class="flex lg:hidden flex-col justify-center items-center w-10 h-10 border-2 border-white/40 text-white p-2 gap-1.5"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="hero-mobile-menu"
        >
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 hero-menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-opacity duration-300 hero-menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 hero-menu-line"></span>
        </button>
      </div>
    </div>

    <div id="hero-mobile-menu" class="lg:hidden max-h-0 overflow-hidden bg-brand-dark transition-all duration-300">
      <nav class="flex flex-col px-5 py-3 gap-0.5 text-sm font-extrabold uppercase tracking-wide">
        {
          links.map((link) => (
            <a href={link.href} class="hero-mobile-link px-3 py-2.5 text-white/85 hover:bg-accent/15 hover:text-accent transition">
              {link.label}
            </a>
          ))
        }
        <a href="/pedido" class="hero-mobile-link btn-primary mt-2 mb-2 inline-flex justify-center px-3 py-2.5 text-xs">
          Enviar PDF
        </a>
      </nav>
    </div>
  </div>
</header>

{/* One composition: full-bleed navy + edge-to-edge photo. Brand is the hero. */}
<section class="relative flex flex-col lg:flex-row min-h-[90vh] lg:min-h-[calc(100vh-3.85rem)]">
  <div class="relative z-10 flex flex-col justify-center bg-brand text-white lg:w-[46%] px-5 sm:px-8 lg:px-12 xl:px-16 py-16 lg:py-20 overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.1]"
      style="background-image: repeating-linear-gradient(transparent, transparent 31px, white 31px, white 32px)"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-20 top-0 bottom-0 w-48 bg-accent rotate-[-8deg] opacity-90"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -right-10 top-0 bottom-0 w-6 bg-brand-dark rotate-[-8deg]"
      aria-hidden="true"
    ></div>
    <DoodleDecor variant="hero" />

    <div class="relative hero-rise max-w-md xl:max-w-lg">
      <h1 class="font-display text-[2.6rem] sm:text-[3.2rem] xl:text-[3.85rem] leading-[0.95] text-white">
        Copistería<br />Central
      </h1>
      <p class="mt-6 text-xl sm:text-2xl font-black text-accent leading-snug">
        Donde te imprimimos tus sueños
      </p>
      <p class="mt-4 text-base sm:text-lg text-white/80 leading-relaxed max-w-sm font-medium">
        Fotocopias, encuadernación y papelería al lado del campus. Vienes con prisas, sales con todo listo.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/pedido" class="btn-primary btn-pulse inline-flex items-center gap-2 px-6 py-3.5 text-xs sm:text-sm">
          <Doodle name="folio" class="h-5 w-4" rotate={-8} />
          Enviar PDF
        </a>
        <a href="/venta" class="btn-secondary inline-flex items-center gap-2 px-6 py-3.5 text-xs sm:text-sm text-white">
          <Doodle name="boli" class="h-6 w-3" rotate={12} />
          Ver papelería
        </a>
      </div>
    </div>
  </div>

  <div class="relative lg:w-[54%] min-h-[44vh] sm:min-h-[52vh] lg:min-h-auto grow border-t-[6px] border-accent lg:border-t-0 lg:border-l-[6px]">
    <img
      src="/galeria/local-fachada.png?v=20261022c"
      alt={heroAlt}
      width="1200"
      height="900"
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/50 via-transparent to-transparent lg:bg-gradient-to-l lg:from-transparent lg:via-transparent lg:to-brand/25"></div>
  </div>
</section>

<script>
  const menuToggle = document.getElementById('hero-menu-toggle');
  const mobileMenu = document.getElementById('hero-mobile-menu');
  const mobileLinks = document.querySelectorAll('.hero-mobile-link');
  const lines = menuToggle?.querySelectorAll('.hero-menu-line');

  function setOpen(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      mobileMenu.classList.remove('max-h-0');
      mobileMenu.classList.add('max-h-[28rem]');
      if (lines && lines.length === 3) {
        lines[0].classList.add('translate-y-2', 'rotate-45');
        lines[1].classList.add('opacity-0');
        lines[2].classList.add('-translate-y-2', '-rotate-45');
      }
    } else {
      mobileMenu.classList.remove('max-h-[28rem]');
      mobileMenu.classList.add('max-h-0');
      if (lines && lines.length === 3) {
        lines[0].classList.remove('translate-y-2', 'rotate-45');
        lines[1].classList.remove('opacity-0');
        lines[2].classList.remove('-translate-y-2', '-rotate-45');
      }
    }
  }

  menuToggle?.addEventListener('click', () => {
    setOpen(mobileMenu?.classList.contains('max-h-0') ?? false);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
