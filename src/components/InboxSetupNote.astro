---
import { site } from '../lib/site';

/**
 * Nota operativa (prototipo): canal primario Resend → Outlook de la tienda.
 */
---

{
  site.isPrototype && (
    <aside class="mt-6 rounded-none border-[3px] border-brand/25 bg-white/80 px-4 py-3 text-sm text-ink leading-relaxed">
      <p class="font-extrabold text-brand uppercase tracking-wide text-xs mb-1">Aviso de pedidos</p>
      <p class="font-medium text-muted">
        Los avisos van a <span class="font-bold text-ink">{site.inboxEmail}</span> vía Resend
        (modo prueba). Tras enviar un pedido, revisa Inbox y Spam de ese Outlook.
      </p>
      <p class="mt-2 text-xs font-semibold text-muted">
        Detalle en <code class="text-[11px]">INSTRUCCIONES.md</code> del repo.
      </p>
    </aside>
  )
}
