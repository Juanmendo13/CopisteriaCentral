---
import { FORMATOS, COLORES, CARAS } from '../data/formatos';
import { site } from '../lib/site';

interface Props {
  defaultFormato?: string;
}

const { defaultFormato = 'A4' } = Astro.props;

const hasBlob = Boolean(process.env.BLOB_READ_WRITE_TOKEN);

const inputClass =
  'w-full rounded-md border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-ink placeholder:text-slate-400 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20';
---

<form
  id="pedido-form"
  class="space-y-8"
  data-has-blob={hasBlob ? '1' : ''}
  data-whatsapp={site.whatsappHref}
  novalidate
>
  <fieldset>
    <legend class="text-sm font-semibold text-ink">Archivo para imprimir</legend>
    <p class="mt-1 text-sm text-slate-500">
      PDF (recomendado), JPG o PNG. Hasta 50 MB. Si pesa menos de 20 MB, llega adjunto al correo.
    </p>
    <label class="mt-3 flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center hover:border-brand/40 hover:bg-brand-soft/40 transition">
      <input
        id="pedido-archivo"
        class="sr-only"
        type="file"
        name="archivo"
        accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png"
        required
      />
      <span class="text-sm font-semibold text-ink">Elige o suelta el archivo</span>
      <span id="pedido-archivo-nombre" class="mt-1 text-sm text-slate-500">Ningún archivo seleccionado</span>
    </label>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-semibold text-ink">Formato (folio)</legend>
    <p class="mt-1 text-sm text-slate-500">El tamaño del papel en el que quieres la impresión.</p>
    <div class="mt-4 grid grid-cols-3 sm:grid-cols-5 gap-2">
      {
        FORMATOS.map((formato) => (
          <label class="relative cursor-pointer">
            <input
              class="peer sr-only"
              type="radio"
              name="formato"
              value={formato.id}
              checked={formato.id === defaultFormato}
            />
            <span class="flex h-full flex-col items-center justify-center rounded-lg border border-slate-200 bg-white px-2 py-3 text-center peer-checked:border-brand peer-checked:bg-brand-soft peer-checked:text-brand peer-focus-visible:ring-2 peer-focus-visible:ring-brand/30">
              <span class="text-sm font-semibold">{formato.label}</span>
              <span class="mt-0.5 text-[10px] leading-tight text-slate-500 peer-checked:text-brand/80">{formato.hint}</span>
            </span>
          </label>
        ))
      }
    </div>
    <label id="pedido-medida-wrap" class="mt-3 block text-sm font-medium text-slate-700 hidden">
      Medida personalizada
      <input class:list={[inputClass, 'mt-1.5']} type="text" name="medida" placeholder="Ej. 70 × 100 cm" maxlength="80" />
    </label>
  </fieldset>

  <div class="grid sm:grid-cols-3 gap-4">
    <fieldset>
      <legend class="text-sm font-medium text-slate-700">Color</legend>
      <div class="mt-2 space-y-2">
        {
          COLORES.map((color, index) => (
            <label class="flex items-center gap-2 text-sm text-slate-700">
              <input type="radio" name="color" value={color.label} checked={index === 0} class="text-brand focus:ring-brand" />
              {color.label}
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend class="text-sm font-medium text-slate-700">Caras</legend>
      <div class="mt-2 space-y-2">
        {
          CARAS.map((cara, index) => (
            <label class="flex items-center gap-2 text-sm text-slate-700">
              <input type="radio" name="caras" value={cara.label} checked={index === 0} class="text-brand focus:ring-brand" />
              {cara.label}
            </label>
          ))
        }
      </div>
    </fieldset>
    <label class="block text-sm font-medium text-slate-700">
      Copias
      <input class:list={[inputClass, 'mt-1.5']} type="number" name="copias" min="1" max="500" value="1" required />
    </label>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <label class="block text-sm font-medium text-slate-700">
      Nombre
      <input class:list={[inputClass, 'mt-1.5']} type="text" name="nombre" autocomplete="name" required minlength="2" maxlength="80" />
    </label>
    <label class="block text-sm font-medium text-slate-700">
      Teléfono
      <input class:list={[inputClass, 'mt-1.5']} type="tel" name="telefono" autocomplete="tel" required />
    </label>
    <label class="block text-sm font-medium text-slate-700 sm:col-span-2">
      Email
      <input class:list={[inputClass, 'mt-1.5']} type="email" name="email" autocomplete="email" required />
    </label>
  </div>

  <label class="block text-sm font-medium text-slate-700">
    Notas (opcional)
    <textarea
      class:list={[inputClass, 'mt-1.5 min-h-24']}
      name="notas"
      maxlength="1000"
      placeholder="Papel, plastificado, fecha de recogida…"
    ></textarea>
  </label>

  <label class="flex items-start gap-2.5 text-sm text-slate-600">
    <input type="checkbox" name="privacidad" required class="mt-1 rounded border-slate-300 text-brand focus:ring-brand" />
    <span>
      He leído y acepto la <a href="/privacidad" class="text-brand hover:underline">política de privacidad</a>.
    </span>
  </label>

  <p id="pedido-error" class="hidden text-sm text-red-700 bg-red-50 border border-red-100 rounded-md px-3 py-2"></p>
  <div id="pedido-ok" class="hidden text-sm text-emerald-800 bg-emerald-50 border border-emerald-100 rounded-md px-3 py-3 space-y-2">
    <p id="pedido-ok-text">Pedido enviado. Te confirmamos precio y recogida por teléfono o email.</p>
    <p id="pedido-ok-extra" class="hidden text-emerald-700"></p>
  </div>

  <button
    type="submit"
    class="inline-flex w-full sm:w-auto justify-center rounded-md bg-brand px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-dark transition disabled:opacity-60"
  >
    Enviar pedido
  </button>
</form>

<script>
  import { upload } from '@vercel/blob/client';
  import { ALLOWED_MIME, MAX_FILE_BYTES } from '../data/formatos';

  const form = document.getElementById('pedido-form') as HTMLFormElement | null;
  const fileInput = document.getElementById('pedido-archivo') as HTMLInputElement | null;
  const fileLabel = document.getElementById('pedido-archivo-nombre');
  const errorEl = document.getElementById('pedido-error');
  const okEl = document.getElementById('pedido-ok');
  const okText = document.getElementById('pedido-ok-text');
  const okExtra = document.getElementById('pedido-ok-extra');
  const medidaWrap = document.getElementById('pedido-medida-wrap');

  function showError(message: string) {
    if (!errorEl || !okEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    okEl.classList.add('hidden');
  }

  function toggleMedida() {
    const selected = form?.querySelector('input[name="formato"]:checked') as HTMLInputElement | null;
    const personalizado = selected?.value === 'Personalizado';
    medidaWrap?.classList.toggle('hidden', !personalizado);
  }

  form?.querySelectorAll('input[name="formato"]').forEach((input) => {
    input.addEventListener('change', toggleMedida);
  });
  toggleMedida();

  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (fileLabel) fileLabel.textContent = file ? `${file.name} (${(file.size / 1024 / 1024).toFixed(1)} MB)` : 'Ningún archivo seleccionado';
  });

  function mimeOk(file: File) {
    if ((ALLOWED_MIME as readonly string[]).includes(file.type)) return true;
    const name = file.name.toLowerCase();
    return name.endsWith('.pdf') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.png');
  }

  function safeFilename(name: string) {
    const base = name.replace(/[^a-zA-Z0-9._-]+/g, '-').replace(/^\.+/, '') || 'archivo.pdf';
    return base.slice(0, 80);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;

    const submitBtn = form.querySelector('button[type="submit"]');
    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const telefono = String(data.get('telefono') ?? '').trim();
    const formato = String(data.get('formato') ?? '').trim();
    const medida = String(data.get('medida') ?? '').trim();
    const color = String(data.get('color') ?? '').trim();
    const caras = String(data.get('caras') ?? '').trim();
    const copias = Number(data.get('copias'));
    const notas = String(data.get('notas') ?? '').trim();
    const file = fileInput?.files?.[0];
    const hasBlob = form.dataset.hasBlob === '1';
    const whatsapp = form.dataset.whatsapp || 'https://wa.me/34611610148';

    if (!file) return showError('Adjunta el PDF (o una imagen) para imprimir.');
    if (!mimeOk(file)) return showError('Solo se admiten PDF, JPG o PNG.');
    if (file.size > MAX_FILE_BYTES) return showError('El archivo supera 50 MB. Envíalo por WhatsApp o tráelo al local.');
    if (nombre.length < 2) return showError('Indica tu nombre.');
    if (!email.includes('@')) return showError('Indica un email válido.');
    if (telefono.replace(/\D/g, '').length < 9) return showError('Indica un teléfono válido.');
    if (!formato) return showError('Elige un formato de papel.');
    if (formato === 'Personalizado' && medida.length < 2) return showError('Indica la medida personalizada.');
    if (!Number.isInteger(copias) || copias < 1 || copias > 500) return showError('Indica un número de copias entre 1 y 500.');
    if (!data.get('privacidad')) return showError('Debes aceptar la política de privacidad.');
    if (!hasBlob) {
      showError(`Falta Vercel Blob para subir el archivo. Escríbenos por WhatsApp: ${whatsapp}`);
      return;
    }

    const formatoLabel = formato === 'Personalizado' ? `Personalizado (${medida})` : formato;

    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Subiendo archivo…';
    }
    errorEl?.classList.add('hidden');
    okEl?.classList.add('hidden');
    okExtra?.classList.add('hidden');

    try {
      const blob = await upload(`pedidos/${safeFilename(file.name)}`, file, {
        access: 'public',
        handleUploadUrl: '/api/upload',
      });

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.textContent = 'Enviando pedido…';
      }

      const response = await fetch('/api/pedido', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          nombre,
          email,
          telefono,
          formato: formatoLabel,
          color,
          caras,
          copias,
          notas,
          archivoUrl: blob.url,
          archivoNombre: file.name,
          archivoSize: file.size,
          archivoTipo: file.type || 'application/pdf',
        }),
      });

      const result = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        mensaje?: string;
        modo?: 'adjunto' | 'enlace';
      };

      if (!response.ok || !result.ok) {
        showError(result.error || 'No se pudo enviar el pedido.');
        return;
      }

      form.reset();
      if (fileLabel) fileLabel.textContent = 'Ningún archivo seleccionado';
      toggleMedida();
      if (okText && result.mensaje) okText.textContent = result.mensaje;
      okEl?.classList.remove('hidden');
      if (okExtra && result.modo === 'enlace') {
        okExtra.textContent = 'Archivos de más de 20 MB no pueden ir adjuntos en el email; recibirás un enlace de descarga.';
        okExtra.classList.remove('hidden');
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : 'No se pudo enviar. Revisa la conexión.';
      showError(message.includes('token') || message.includes('Blob') ? `Error al subir el archivo. WhatsApp: ${whatsapp}` : message);
    } finally {
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar pedido';
      }
    }
  });
</script>
