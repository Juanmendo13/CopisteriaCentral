---
import { FORMATOS, COLORES, CARAS } from '../data/formatos';
import { site, whatsappLink } from '../lib/site';

interface Props {
  defaultFormato?: string;
}

const { defaultFormato = 'A4' } = Astro.props;

const hasBlob = Boolean(process.env.BLOB_READ_WRITE_TOKEN);
const waPedido = whatsappLink(
  `Hola, soy de Copistería Central. Quiero enviar un archivo para imprimir (o tengo dudas del pedido).`,
);
---

<form
  id="pedido-form"
  class="space-y-8"
  data-has-blob={hasBlob ? '1' : ''}
  data-whatsapp={waPedido}
  novalidate
>
  <fieldset>
    <legend class="text-sm font-black uppercase tracking-wide text-brand">Archivo para imprimir</legend>
    <p class="mt-1 text-sm text-muted font-medium">
      PDF (recomendado), JPG o PNG. Hasta 50 MB. Si pesa menos de 20 MB, llega adjunto al correo.
    </p>
    <label id="pedido-dropzone" class="dropzone-stamp mt-3">
      <input
        id="pedido-archivo"
        class="sr-only"
        type="file"
        name="archivo"
        accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png"
        required
      />
      <span class="text-sm font-black uppercase tracking-wide text-brand">Elige o suelta el archivo</span>
      <span id="pedido-archivo-nombre" class="mt-1.5 text-sm text-muted font-semibold">Ningún archivo seleccionado</span>
    </label>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-black uppercase tracking-wide text-brand">Formato (folio)</legend>
    <p class="mt-1 text-sm text-muted font-medium">El tamaño del papel en el que quieres la impresión.</p>
    <div class="mt-4 grid grid-cols-3 sm:grid-cols-5 gap-2">
      {
        FORMATOS.map((formato) => (
          <label class="relative cursor-pointer">
            <input
              class="peer sr-only"
              type="radio"
              name="formato"
              value={formato.id}
              checked={formato.id === defaultFormato}
            />
            <span class="choice-stamp">
              <span class="text-sm font-extrabold">{formato.label}</span>
              <span class="mt-0.5 text-[10px] leading-tight text-muted peer-checked:text-accent/80">{formato.hint}</span>
            </span>
          </label>
        ))
      }
    </div>
    <label id="pedido-medida-wrap" class="mt-3 block text-sm font-bold text-brand hidden">
      Medida personalizada
      <input class="field-stamp mt-1.5" type="text" name="medida" placeholder="Ej. 70 × 100 cm" maxlength="80" />
    </label>
  </fieldset>

  <div class="grid sm:grid-cols-3 gap-4">
    <fieldset>
      <legend class="text-sm font-black uppercase tracking-wide text-brand">Color</legend>
      <div class="mt-2 space-y-2">
        {
          COLORES.map((color, index) => (
            <label class="flex items-center gap-2 text-sm font-semibold text-ink">
              <input type="radio" name="color" value={color.label} checked={index === 0} class="accent-[#002d62]" />
              {color.label}
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend class="text-sm font-black uppercase tracking-wide text-brand">Caras</legend>
      <div class="mt-2 space-y-2">
        {
          CARAS.map((cara, index) => (
            <label class="flex items-center gap-2 text-sm font-semibold text-ink">
              <input type="radio" name="caras" value={cara.label} checked={index === 0} class="accent-[#002d62]" />
              {cara.label}
            </label>
          ))
        }
      </div>
    </fieldset>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Copias
      <input class="field-stamp mt-1.5 normal-case tracking-normal font-semibold" type="number" name="copias" min="1" max="500" value="1" required />
    </label>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Nombre
      <input class="field-stamp mt-1.5 normal-case tracking-normal font-semibold" type="text" name="nombre" autocomplete="name" required minlength="2" maxlength="80" />
    </label>
    <label class="block text-sm font-black uppercase tracking-wide text-brand">
      Teléfono
      <input class="field-stamp mt-1.5 normal-case tracking-normal font-semibold" type="tel" name="telefono" autocomplete="tel" required />
    </label>
    <label class="block text-sm font-black uppercase tracking-wide text-brand sm:col-span-2">
      Email
      <input class="field-stamp mt-1.5 normal-case tracking-normal font-semibold" type="email" name="email" autocomplete="email" required />
    </label>
  </div>

  <label class="block text-sm font-black uppercase tracking-wide text-brand">
    Notas (opcional)
    <textarea
      class="field-stamp mt-1.5 min-h-24 normal-case tracking-normal font-semibold"
      name="notas"
      maxlength="1000"
      placeholder="Papel, plastificado, fecha de recogida…"
    ></textarea>
  </label>

  <label class="flex items-start gap-2.5 text-sm font-semibold text-muted">
    <input type="checkbox" name="privacidad" required class="mt-1 accent-[#002d62]" />
    <span>
      He leído y acepto la <a href="/privacidad" class="text-brand font-black underline decoration-2 underline-offset-2">política de privacidad</a>.
    </span>
  </label>

  <p id="pedido-error" class="alert-stamp alert-stamp-error hidden" role="alert"></p>
  <div id="pedido-ok" class="alert-stamp alert-stamp-ok hidden space-y-3" role="status">
    <p id="pedido-ok-text" class="font-extrabold">Pedido enviado. Te confirmamos precio y recogida por teléfono o email.</p>
    <p id="pedido-ok-extra" class="hidden text-sm font-medium"></p>
    <a
      id="pedido-ok-wa"
      href={waPedido}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-wide text-brand underline decoration-2 underline-offset-4"
    >
      ¿Dudas? Escríbenos por WhatsApp →
    </a>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
    <button type="submit" id="pedido-submit" class="btn-navy inline-flex w-full sm:w-auto justify-center px-6 py-3.5 text-sm">
      Enviar pedido
    </button>
    <a
      href={waPedido}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex justify-center text-sm font-black uppercase tracking-wide text-brand hover:underline decoration-2 underline-offset-4"
    >
      O por WhatsApp
    </a>
  </div>
  <p class="text-xs text-muted font-medium">
    Recogida en {site.addressLine}. Tel. <a class="text-brand font-bold underline" href={site.phoneHref}>{site.phone}</a>
  </p>
</form>

<script>
  import { upload } from '@vercel/blob/client';
  import { ALLOWED_MIME, MAX_FILE_BYTES } from '../data/formatos';
  import { sendShopFormSubmit } from '../lib/client-formsubmit';

  const form = document.getElementById('pedido-form') as HTMLFormElement | null;
  const fileInput = document.getElementById('pedido-archivo') as HTMLInputElement | null;
  const fileLabel = document.getElementById('pedido-archivo-nombre');
  const dropzone = document.getElementById('pedido-dropzone');
  const errorEl = document.getElementById('pedido-error');
  const okEl = document.getElementById('pedido-ok');
  const okText = document.getElementById('pedido-ok-text');
  const okExtra = document.getElementById('pedido-ok-extra');
  const medidaWrap = document.getElementById('pedido-medida-wrap');
  const submitBtn = document.getElementById('pedido-submit') as HTMLButtonElement | null;

  function showError(message: string) {
    if (!errorEl || !okEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    okEl.classList.add('hidden');
    errorEl.focus?.();
  }

  function setFileName(file: File | undefined) {
    if (fileLabel) {
      fileLabel.textContent = file
        ? `${file.name} (${(file.size / 1024 / 1024).toFixed(1)} MB)`
        : 'Ningún archivo seleccionado';
    }
  }

  function toggleMedida() {
    const selected = form?.querySelector('input[name="formato"]:checked') as HTMLInputElement | null;
    const personalizado = selected?.value === 'Personalizado';
    medidaWrap?.classList.toggle('hidden', !personalizado);
  }

  form?.querySelectorAll('input[name="formato"]').forEach((input) => {
    input.addEventListener('change', toggleMedida);
  });
  toggleMedida();

  fileInput?.addEventListener('change', () => {
    setFileName(fileInput.files?.[0]);
  });

  // Drag & drop
  ['dragenter', 'dragover'].forEach((evt) => {
    dropzone?.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.add('is-dragover');
    });
  });
  ['dragleave', 'drop'].forEach((evt) => {
    dropzone?.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.classList.remove('is-dragover');
    });
  });
  dropzone?.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    const file = dt?.files?.[0];
    if (file && fileInput) {
      const transfer = new DataTransfer();
      transfer.items.add(file);
      fileInput.files = transfer.files;
      setFileName(file);
    }
  });

  function mimeOk(file: File) {
    if ((ALLOWED_MIME as readonly string[]).includes(file.type)) return true;
    const name = file.name.toLowerCase();
    return name.endsWith('.pdf') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.png');
  }

  function safeFilename(name: string) {
    const base = name.replace(/[^a-zA-Z0-9._-]+/g, '-').replace(/^\.+/, '') || 'archivo.pdf';
    return base.slice(0, 80);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form) return;

    const data = new FormData(form);
    const nombre = String(data.get('nombre') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const telefono = String(data.get('telefono') ?? '').trim();
    const formato = String(data.get('formato') ?? '').trim();
    const medida = String(data.get('medida') ?? '').trim();
    const color = String(data.get('color') ?? '').trim();
    const caras = String(data.get('caras') ?? '').trim();
    const copias = Number(data.get('copias'));
    const notas = String(data.get('notas') ?? '').trim();
    const file = fileInput?.files?.[0];
    const hasBlob = form.dataset.hasBlob === '1';
    const whatsapp = form.dataset.whatsapp || 'https://wa.me/34954625384';

    if (!file) return showError('Adjunta el PDF (o una imagen) para imprimir.');
    if (!mimeOk(file)) return showError('Solo se admiten PDF, JPG o PNG.');
    if (file.size > MAX_FILE_BYTES) return showError('El archivo supera 50 MB. Envíalo por WhatsApp o tráelo al local.');
    if (nombre.length < 2) return showError('Indica tu nombre.');
    if (!email.includes('@')) return showError('Indica un email válido.');
    if (telefono.replace(/\D/g, '').length < 9) return showError('Indica un teléfono válido.');
    if (!formato) return showError('Elige un formato de papel.');
    if (formato === 'Personalizado' && medida.length < 2) return showError('Indica la medida personalizada.');
    if (!Number.isInteger(copias) || copias < 1 || copias > 500) return showError('Indica un número de copias entre 1 y 500.');
    if (!data.get('privacidad')) return showError('Debes aceptar la política de privacidad.');
    if (!hasBlob) {
      showError(`Falta subir el archivo ahora mismo. Escríbenos por WhatsApp y lo vemos.`);
      return;
    }

    const formatoLabel = formato === 'Personalizado' ? `Personalizado (${medida})` : formato;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Subiendo archivo…';
      submitBtn.setAttribute('aria-busy', 'true');
    }
    errorEl?.classList.add('hidden');
    okEl?.classList.add('hidden');
    okExtra?.classList.add('hidden');

    try {
      const blob = await upload(`pedidos/${safeFilename(file.name)}`, file, {
        access: 'public',
        handleUploadUrl: '/api/upload',
      });

      if (submitBtn) submitBtn.textContent = 'Enviando pedido…';

      const response = await fetch('/api/pedido', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          nombre,
          email,
          telefono,
          formato: formatoLabel,
          color,
          caras,
          copias,
          notas,
          archivoUrl: blob.url,
          archivoNombre: file.name,
          archivoSize: file.size,
          archivoTipo: file.type || 'application/pdf',
        }),
      });

      const result = (await response.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
        mensaje?: string;
        modo?: 'adjunto' | 'enlace';
        formsubmit?: {
          to: string;
          subject: string;
          message: string;
          replyTo: string;
          name?: string;
        };
      };

      if (!response.ok || !result.ok || !result.formsubmit) {
        showError(result.error || 'No se pudo enviar el pedido.');
        return;
      }

      const gmail = await sendShopFormSubmit(result.formsubmit);

      form.reset();
      setFileName(undefined);
      toggleMedida();
      if (okText) {
        okText.textContent = gmail.ok
          ? 'Pedido enviado. La tienda recibe el aviso con el enlace al archivo.'
          : gmail.needsActivation
            ? gmail.error
            : 'Pedido registrado con respaldo. Si no te llaman, escribe o llama al local.';
      }
      okEl?.classList.remove('hidden');
      if (okExtra) {
        okExtra.textContent = 'El PDF va como enlace de descarga en el correo de la tienda.';
        okExtra.classList.remove('hidden');
      }
      okEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (error) {
      const message = error instanceof Error ? error.message : 'No se pudo enviar. Revisa la conexión.';
      showError(
        message.includes('token') || message.includes('Blob')
          ? `Error al subir el archivo. Mejor por WhatsApp.`
          : message,
      );
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar pedido';
        submitBtn.removeAttribute('aria-busy');
      }
    }
  });
</script>
