---
import { site } from '../lib/site';

interface Props {
  variant?: 'tech' | 'negocios';
}

const { variant = 'tech' } = Astro.props;
const isNegocios = variant === 'negocios';
---

<footer class="border-t border-line bg-void px-5 py-10 sm:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-display text-lg font-bold tracking-[0.12em] text-acid">
      {site.brand}<span class="text-cyan">_</span>
    </p>
    <div class="flex flex-col gap-3 sm:items-end">
      <p class="font-mono text-xs text-mist">
        © {new Date().getFullYear()}
        <span class="mx-2 text-line" aria-hidden="true">·</span>
        <span data-i18n="footer.copy">Ingeniería & webs para negocios locales</span>
        <span class="mx-2 text-line" aria-hidden="true">·</span>
        <span data-i18n="footer.rights">Portfolio personal</span>
      </p>
      {
        isNegocios ? (
          <a
            href="/"
            class="font-mono text-[11px] uppercase tracking-[0.16em] text-cyan transition hover:text-acid"
            data-i18n="footer.tech"
          >
            Perfil técnico
          </a>
        ) : (
          <a
            href="/negocios"
            class="font-mono text-[11px] uppercase tracking-[0.16em] text-cyan transition hover:text-acid"
            data-i18n="footer.negocios"
          >
            ¿Tienes un local?
          </a>
        )
      }
    </div>
  </div>
</footer>
