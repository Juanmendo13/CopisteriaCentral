---
import { site } from '../lib/site';
---

<footer class="border-t border-line bg-ink px-5 py-10 text-paper/60 sm:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-display text-lg font-bold text-paper">{site.name}</p>
    <p class="text-sm font-medium">
      © {new Date().getFullYear()} · {site.tagline}
    </p>
  </div>
</footer>
