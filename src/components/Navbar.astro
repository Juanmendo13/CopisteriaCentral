---
import { site } from '../lib/site';
import PrototypeBanner from './PrototypeBanner.astro';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/venta', label: 'Venta' },
  { href: '/precios', label: 'Precios' },
  { href: '/pedido', label: 'Enviar archivo' },
  { href: '/imagenes', label: 'Imágenes' },
  { href: '/informacion', label: 'Información' },
  { href: '/contacto', label: 'Contacto' },
];

const current = Astro.url.pathname;
const isVenta = current === '/venta' || current.startsWith('/venta/');
---

<header
  class:list={[
    'site-header fixed top-0 left-0 w-full z-50',
    site.isPrototype && 'has-banner',
    isVenta && 'has-venta-cart-bar',
  ]}
>
  <PrototypeBanner />
  <div class="bg-brand border-b-[6px] border-accent">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 h-14 md:h-[3.85rem] flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <span class="stamp-mark h-10 w-10 text-sm">{site.shortName}</span>
        <span class="font-display text-[15px] sm:text-[17px] text-white leading-none">Copistería Central</span>
      </a>

      <nav class="hidden lg:flex items-center gap-0.5 text-xs font-extrabold uppercase tracking-wide">
        {
          links.map((link) => {
            const active =
              link.href === '/'
                ? current === '/'
                : link.href === '/servicios'
                  ? current === '/servicios' || current.startsWith('/servicio/')
                  : current === link.href || current.startsWith(`${link.href}/`);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-2 py-1.5 transition',
                  active ? 'nav-active' : 'text-white/80 hover:text-accent',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-2">
        <a href="/pedido" class="btn-primary hidden sm:inline-flex items-center px-4 py-2 text-xs">
          Enviar PDF
        </a>
        <button
          id="menu-toggle"
          class="flex lg:hidden flex-col justify-center items-center w-10 h-10 border-2 border-white/40 text-white p-2 gap-1.5"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-opacity duration-300 menu-line"></span>
          <span class="w-5 h-0.5 bg-current transition-transform duration-300 menu-line"></span>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="lg:hidden max-h-0 overflow-hidden bg-brand-dark transition-all duration-300">
      <nav class="flex flex-col px-5 pt-2 pb-4 gap-0.5 text-sm font-extrabold uppercase tracking-wide">
        {
          links.map((link) => (
            <a href={link.href} class="mobile-link px-3 py-2.5 text-white/85 hover:bg-accent/15 hover:text-accent">
              {link.label}
            </a>
          ))
        }
        <a href="/pedido" class="mobile-link btn-primary mt-2 mx-1 inline-flex justify-center px-3 py-2.5 text-xs">
          Enviar PDF
        </a>
      </nav>
    </div>
  </div>

  {
    isVenta && (
      <div
        id="venta-cart-bar"
        class="lg:hidden border-b-[3px] border-brand bg-accent shadow-[0_3px_0_rgba(0,45,98,0.18)]"
      >
        <div class="max-w-6xl mx-auto px-5 sm:px-8">
          <button
            type="button"
            id="venta-cart-jump"
            class="flex w-full items-center justify-between gap-3 py-2.5 text-left"
            aria-controls="lista-compra"
          >
            <span class="flex items-center gap-2 min-w-0">
              <span class="rounded-sm border-2 border-brand bg-brand px-2 py-0.5 text-[10px] font-black uppercase tracking-[0.12em] text-accent shrink-0">
                Lista
              </span>
              <span id="venta-cart-bar-count" class="text-sm font-extrabold text-brand truncate">
                0 artículos
              </span>
            </span>
            <span
              id="venta-cart-bar-subtotal"
              class="shrink-0 rounded-sm border-2 border-brand bg-white px-2.5 py-0.5 text-sm font-black text-brand tabular-nums"
            >
              0,00 €
            </span>
          </button>
        </div>
      </div>
    )
  }
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const lines = menuToggle?.querySelectorAll('.menu-line');

  function setOpen(open: boolean) {
    if (!mobileMenu || !menuToggle) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    if (open) {
      mobileMenu.classList.remove('max-h-0');
      mobileMenu.classList.add('max-h-[32rem]');
      if (lines && lines.length === 3) {
        lines[0].classList.add('translate-y-2', 'rotate-45');
        lines[1].classList.add('opacity-0');
        lines[2].classList.add('-translate-y-2', '-rotate-45');
      }
    } else {
      mobileMenu.classList.remove('max-h-[32rem]');
      mobileMenu.classList.add('max-h-0');
      if (lines && lines.length === 3) {
        lines[0].classList.remove('translate-y-2', 'rotate-45');
        lines[1].classList.remove('opacity-0');
        lines[2].classList.remove('-translate-y-2', '-rotate-45');
      }
    }
  }

  menuToggle?.addEventListener('click', () => {
    setOpen(mobileMenu?.classList.contains('max-h-0') ?? false);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const cartBarCount = document.getElementById('venta-cart-bar-count');
  const cartBarSubtotal = document.getElementById('venta-cart-bar-subtotal');
  const cartJump = document.getElementById('venta-cart-jump');

  function articulosLabel(qty: number) {
    if (qty === 1) return '1 artículo';
    return `${qty} artículos`;
  }

  window.addEventListener('cc-venta-cart', ((ev: CustomEvent<{ qty: number; formatted: string }>) => {
    const { qty, formatted } = ev.detail;
    if (cartBarCount) cartBarCount.textContent = articulosLabel(qty);
    if (cartBarSubtotal) cartBarSubtotal.textContent = formatted;
  }) as EventListener);

  cartJump?.addEventListener('click', () => {
    setOpen(false);
    document.getElementById('lista-compra')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
