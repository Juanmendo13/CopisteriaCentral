---
import { site } from '../lib/site';
---

<section class="relative isolate min-h-[100svh] overflow-hidden text-fog">
  <div class="absolute inset-0 -z-10 bg-void">
    <!-- Dominant full-bleed cyberpunk cityscape -->
    <img
      src="/portfolio/hero-cyberpunk.jpg"
      alt=""
      class="absolute inset-0 h-full w-full scale-105 object-cover object-[center_35%]"
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <!-- Neon color grade + readability veil (keep skyline visible) -->
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgb(5_8_15_/_0.35)_0%,rgb(5_8_15_/_0.2)_40%,rgb(5_8_15_/_0.78)_100%),radial-gradient(ellipse_at_20%_15%,rgb(184_255_61_/_0.14),transparent_42%),radial-gradient(ellipse_at_90%_25%,rgb(255_61_122_/_0.16),transparent_40%)]"
      aria-hidden="true"
    >
    </div>
    <!-- Perspective neon grid floor -->
    <div class="hero-grid absolute inset-x-0 bottom-0 h-[48%] opacity-70" aria-hidden="true"></div>
    <!-- Neon rain -->
    <div class="neon-rain absolute inset-0 opacity-80" aria-hidden="true"></div>
    <div class="scan-beam" aria-hidden="true"></div>
    <!-- CRT vignette -->
    <div
      class="pointer-events-none absolute inset-0 shadow-[inset_0_0_120px_40px_rgb(5_8_15_/_0.65)]"
      aria-hidden="true"
    >
    </div>
  </div>

  <div
    class="mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 sm:px-8 sm:pb-20 lg:pb-24"
  >
    <p
      class="animate-rise font-mono text-[11px] uppercase tracking-[0.28em] text-cyan drop-shadow-[0_0_10px_rgb(61_232_255_/_0.55)] sm:text-xs"
      data-i18n="hero.kicker"
    >
      Ingeniería Informática · Sevilla / Milano
    </p>
    <p
      class="animate-rise-delay-1 font-display mt-4 text-[clamp(3.5rem,14vw,9rem)] font-extrabold leading-[0.88] tracking-[-0.03em] text-acid drop-shadow-[0_0_28px_rgb(184_255_61_/_0.45)]"
    >
      {site.brand}
    </p>
    <div
      class="animate-pulse-line mt-5 h-px w-28 bg-gradient-to-r from-acid via-cyan to-transparent sm:mt-6 sm:w-40"
      aria-hidden="true"
    >
    </div>
    <h1
      class="animate-rise-delay-2 mt-6 max-w-2xl font-display text-2xl font-bold leading-tight tracking-tight text-fog sm:text-3xl lg:text-[2.35rem]"
      data-i18n="hero.headline"
    >
      Webs que trabajan para el negocio local.
    </h1>
    <p
      class="animate-rise-delay-2 mt-4 max-w-md text-base font-medium leading-relaxed text-mist sm:text-lg"
      data-i18n="hero.lead"
    >
      Claridad, velocidad y personalidad. De la ficha de Maps a una herramienta que el mostrador usa
      de verdad.
    </p>
    <div class="animate-rise-delay-3 mt-8 flex flex-wrap gap-3">
      <a href="#proyectos" class="btn-primary" data-i18n="hero.ctaWork">Ver proyectos</a>
      <a href="#contacto" class="btn-ghost" data-i18n="hero.ctaContact">Contactar</a>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(rgb(61 232 255 / 0.22) 1px, transparent 1px),
      linear-gradient(90deg, rgb(184 255 61 / 0.14) 1px, transparent 1px);
    background-size: 56px 56px;
    transform: perspective(520px) rotateX(58deg);
    transform-origin: center bottom;
    mask-image: linear-gradient(to top, black 10%, transparent 85%);
    animation: grid-drift 14s linear infinite;
  }

  .neon-rain {
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent 10px,
      rgb(61 232 255 / 0.045) 10px,
      rgb(61 232 255 / 0.045) 11px,
      transparent 11px,
      transparent 18px,
      rgb(184 255 61 / 0.035) 18px,
      rgb(184 255 61 / 0.035) 19px
    );
    background-size: 100% 220px;
    animation: rain-fall 1.1s linear infinite;
    mix-blend-mode: screen;
  }

  @keyframes rain-fall {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 0 220px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid,
    .neon-rain {
      animation: none;
    }
  }
</style>
