---
import { site } from '../lib/site';
---

<section class="relative isolate min-h-[100svh] overflow-hidden text-white">
  <div class="absolute inset-0 -z-10">
    <img
      src="/portfolio/hero.jpg"
      alt=""
      class="animate-ken h-full w-full object-cover"
      width="2400"
      height="1800"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/35"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,transparent_0%,rgb(18_20_15/0.45)_70%)]"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class="mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 sm:px-8 sm:pb-20 lg:pb-24">
    <p class="animate-rise font-display text-5xl font-extrabold leading-[0.95] tracking-[-0.03em] sm:text-7xl lg:text-8xl">
      {site.name}
    </p>
    <div class="animate-draw mt-5 h-1 w-24 bg-signal sm:mt-6 sm:w-32" aria-hidden="true"></div>
    <h1 class="animate-rise-delay-1 mt-6 max-w-2xl font-display text-2xl font-bold leading-tight tracking-tight text-white/95 sm:text-3xl lg:text-4xl">
      Webs que trabajan<br class="hidden sm:block" /> para el negocio local.
    </h1>
    <p class="animate-rise-delay-2 mt-4 max-w-md text-base font-medium leading-relaxed text-white/70 sm:text-lg">
      {site.tagline}. Diseño, desarrollo y puesta en marcha — sin ruido, con resultado.
    </p>
    <div class="animate-rise-delay-3 mt-8 flex flex-wrap gap-3">
      <a href="#trabajo" class="btn-primary">Ver trabajo</a>
      <a href="#contacto" class="btn-ghost border-white/40 text-white">Contactar</a>
    </div>
  </div>
</section>
