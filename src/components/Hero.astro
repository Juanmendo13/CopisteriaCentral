---
import { site } from '../lib/site';
---

<section class="relative isolate min-h-[100svh] overflow-hidden text-fog">
  <div class="absolute inset-0 -z-10 bg-void">
    <div class="absolute inset-0 animate-grid grid-floor opacity-90" aria-hidden="true"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_10%,rgb(184_255_61_/_0.12),transparent_45%),radial-gradient(ellipse_at_85%_20%,rgb(255_61_122_/_0.1),transparent_40%),radial-gradient(ellipse_at_50%_100%,rgb(61_232_255_/_0.08),transparent_50%)]"
      aria-hidden="true"
    >
    </div>
    <img
      src="/portfolio/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-[0.28] mix-blend-luminosity"
      width="2400"
      height="1800"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-void via-void/75 to-void/40"
      aria-hidden="true"
    >
    </div>
    <div class="scan-beam" aria-hidden="true"></div>
  </div>

  <div
    class="mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 sm:px-8 sm:pb-20 lg:pb-24"
  >
    <p
      class="animate-rise font-mono text-[11px] uppercase tracking-[0.28em] text-cyan sm:text-xs"
      data-i18n="hero.kicker"
    >
      Ingeniería Informática · Sevilla / Milano
    </p>
    <p
      class="animate-rise-delay-1 font-display mt-4 text-[clamp(3.5rem,14vw,9rem)] font-extrabold leading-[0.88] tracking-[-0.03em] text-acid"
    >
      {site.brand}
    </p>
    <div
      class="animate-pulse-line mt-5 h-px w-28 bg-gradient-to-r from-acid via-cyan to-transparent sm:mt-6 sm:w-40"
      aria-hidden="true"
    >
    </div>
    <h1
      class="animate-rise-delay-2 mt-6 max-w-2xl font-display text-2xl font-bold leading-tight tracking-tight text-fog sm:text-3xl lg:text-[2.35rem]"
      data-i18n="hero.headline"
    >
      Webs que trabajan para el negocio local.
    </h1>
    <p
      class="animate-rise-delay-2 mt-4 max-w-md text-base font-medium leading-relaxed text-mist sm:text-lg"
      data-i18n="hero.lead"
    >
      Claridad, velocidad y personalidad. De la ficha de Maps a una herramienta que el mostrador usa
      de verdad.
    </p>
    <div class="animate-rise-delay-3 mt-8 flex flex-wrap gap-3">
      <a href="#proyectos" class="btn-primary" data-i18n="hero.ctaWork">Ver proyectos</a>
      <a href="#contacto" class="btn-ghost" data-i18n="hero.ctaContact">Contactar</a>
    </div>
  </div>
</section>
