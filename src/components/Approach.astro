---
const points = [
  {
    title: 'Primero el local',
    body: 'Horario, teléfono, Maps y el flujo real del negocio. La web refuerza el mostrador, no lo sustituye.',
  },
  {
    title: 'Rápido y claro',
    body: 'Astro, tipografía legible, cero relleno. El cliente encuentra lo que necesita en el móvil, en segundos.',
  },
  {
    title: 'Listo para usar',
    body: 'Pedidos, formularios y despliegue en Vercel. Entrego algo que se puede enseñar mañana en el local.',
  },
];
---

<section id="enfoque" class="scroll-mt-8 border-b border-line bg-field px-5 py-20 text-paper sm:px-8 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <header class="mb-12 max-w-xl sm:mb-16">
      <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-signal">Enfoque</p>
      <h2 class="font-display mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl lg:text-5xl">
        Cómo trabajo
      </h2>
      <p class="mt-4 text-base font-medium leading-relaxed text-paper/70 sm:text-lg">
        Menos dashboard, más resultado. Una web que el dueño entiende y el cliente usa.
      </p>
    </header>

    <ol class="grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        points.map((point, i) => (
          <li>
            <span class="font-display text-4xl font-extrabold text-signal/80">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-display mt-4 text-xl font-bold tracking-tight">{point.title}</h3>
            <p class="mt-3 text-sm font-medium leading-relaxed text-paper/65 sm:text-base">
              {point.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
