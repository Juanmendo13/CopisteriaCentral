---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}

const { eyebrow, title, description, align = 'left', dark = false } = Astro.props;
---

<div class:list={[align === 'center' && 'text-center mx-auto max-w-2xl']}>
  {eyebrow && (
    <p class:list={['mb-2 text-sm font-medium', dark ? 'text-accent' : 'text-brand']}>
      {eyebrow}
    </p>
  )}
  <h2
    class:list={[
      'font-display text-2xl sm:text-3xl font-bold tracking-tight leading-snug',
      dark ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {description && (
    <p class:list={['mt-3 text-base leading-relaxed max-w-xl', dark ? 'text-white/65' : 'text-muted']}>
      {description}
    </p>
  )}
</div>
