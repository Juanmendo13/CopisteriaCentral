---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}

const { eyebrow, title, description, align = 'left', dark = false } = Astro.props;
---

<div class:list={[align === 'center' && 'text-center mx-auto max-w-2xl']}>
  {eyebrow && (
    <p
      class:list={[
        'mb-4 text-[11px] font-extrabold uppercase tracking-[0.28em]',
        dark ? 'text-accent' : 'text-brand',
        align === 'left' && 'border-l-2 border-accent pl-3',
      ]}
    >
      {eyebrow}
    </p>
  )}
  <h2
    class:list={[
      'font-display text-3xl sm:text-4xl font-black tracking-[-0.025em] leading-tight',
      dark ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {description && (
    <p class:list={['mt-4 text-base sm:text-lg leading-relaxed font-medium', dark ? 'text-white/65' : 'text-muted']}>
      {description}
    </p>
  )}
</div>
