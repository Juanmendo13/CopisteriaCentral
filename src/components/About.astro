---
---

<section
  id="sobre"
  class="scroll-mt-8 border-y border-line bg-void-2 px-5 py-20 sm:px-8 sm:py-28"
>
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12 lg:gap-12">
    <header class="lg:col-span-5">
      <p
        class="font-mono text-[11px] uppercase tracking-[0.22em] text-hot"
        data-i18n="about.kicker"
      >
        Sobre mí
      </p>
      <h2
        class="font-display mt-3 text-3xl font-extrabold tracking-tight text-fog sm:text-4xl"
        data-i18n="about.title"
      >
        Juan, de Sevilla.
      </h2>
    </header>
    <div class="lg:col-span-7">
      <p
        class="text-base font-medium leading-relaxed text-mist sm:text-lg"
        data-i18n="about.body"
      >
        Soy Juan: cuarto curso de Ingeniería Informática, ahora de Erasmus en el Politecnico di
        Milano. Trabajo full-stack de punta a punta —UI/UX y sitios rápidos en el cliente; APIs,
        auth, email, subida de archivos (Blob), paneles admin/PDA y despliegue en Vercel en el
        servidor—. Construyo herramientas para comercios locales (pedidos, cartas, catálogos,
        presupuestos) y me interesan la IA y la ciberseguridad.
      </p>
      <p class="mt-5 font-mono text-sm text-cyan" data-i18n="about.lang">
        Español nativo · English C1
      </p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {
          (['about.tag1', 'about.tag2', 'about.tag3', 'about.tag4', 'about.tag5'] as const).map(
            (key, i) => (
              <li
                class="border border-line bg-panel px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider text-acid"
                data-i18n={key}
              >
                {
                  [
                    'Frontend · UI/UX · SSR',
                    'Backend · APIs · Auth',
                    'Email · Blob · Admin/PDA',
                    'Deploy Vercel',
                    'IA · Ciberseguridad',
                  ][i]
                }
              </li>
            ),
          )
        }
      </ul>
    </div>
  </div>
</section>
