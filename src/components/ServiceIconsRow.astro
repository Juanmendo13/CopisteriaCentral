---
import Doodle from './Doodle.astro';

const items = [
  {
    label: 'Fotocopias',
    href: '/servicio/fotocopias',
    doodle: 'folio' as const,
  },
  {
    label: 'Impresión',
    href: '/servicio/impresiones-pequeno-formato',
    doodle: 'boli' as const,
  },
  {
    label: 'Encuadernación',
    href: '/servicio/encuadernaciones',
    doodle: 'cuaderno' as const,
  },
  {
    label: 'Plastificados',
    href: '/servicio/plastificados-laminados',
    doodle: 'cinta' as const,
  },
  {
    label: 'Gran formato',
    href: '/servicio/impresiones-gran-formato',
    doodle: 'regla' as const,
  },
  {
    label: 'Papelería',
    href: '/venta',
    doodle: 'lapiz' as const,
  },
];
---

<section class="band-navy relative overflow-hidden py-10 sm:py-12 px-5 sm:px-8">
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.08]"
    style="background-image: repeating-linear-gradient(transparent, transparent 27px, white 27px, white 28px)"
    aria-hidden="true"
  ></div>
  <div class="relative max-w-6xl mx-auto">
    <p class="text-xs text-accent mb-6 inline-flex items-center gap-2 font-black tracking-[0.14em] uppercase">
      <Doodle name="clip" class="h-5 w-3" rotate={20} />
      Atajos del mostrador
    </p>
    {/* Horizontal stamp strip — not a soft icon card row */}
    <ul class="flex flex-wrap lg:flex-nowrap gap-3 sm:gap-4">
      {
        items.map((item, i) => (
          <li class="flex-1 min-w-[42%] sm:min-w-[30%] lg:min-w-0">
            <a
              href={item.href}
              class:list={[
                'group flex flex-col items-center gap-2 border-[3px] border-accent px-3 py-4 text-center transition hover:bg-accent hover:text-brand-dark',
                i % 2 === 0 ? 'bg-accent/10' : 'bg-white/5',
                i % 3 === 1 && 'lg:-translate-y-1',
                i % 3 === 2 && 'lg:translate-y-1',
              ]}
            >
              <Doodle name={item.doodle} class="h-9 w-9 sm:h-11 sm:w-11" rotate={i % 2 === 0 ? -8 : 10} />
              <span class="text-xs sm:text-sm font-black uppercase tracking-wide text-white group-hover:text-brand-dark transition">
                {item.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
