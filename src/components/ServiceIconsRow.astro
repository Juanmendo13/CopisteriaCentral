      {
        items.map((item) => (
          <li>
            <a href={item.href} class="price-ticket group inline-flex items-center gap-2.5 border border-line pl-3.5 pr-3.5 py-2 text-ink hover:border-brand/40 transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.path} />
              </svg>
              <span class="text-sm font-medium">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
