---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../lib/site';
---

<Layout
  title={`Contacto | ${site.name}`}
  description={`Presupuesto y contacto: ${site.phone}. ${site.address}.`}
>
  <Navbar />

  <main class="pt-28 pb-16 px-5 sm:px-8">
    <div class="max-w-6xl mx-auto">
    <div class="max-w-2xl mb-10">
      <p class="text-sm font-medium text-brand mb-2">Pedidos</p>
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink">Contacto</h1>
      <p class="mt-4 text-muted leading-relaxed">
        Para imprimir un PDF, usa <a href="/pedido" class="text-brand font-semibold hover:underline">enviar archivo</a>.
        Para papelería, mira la <a href="/venta" class="text-brand font-semibold hover:underline">venta</a>.
        Si solo quieres precio o una consulta, usa el formulario.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="rounded-xl border border-line bg-white p-6 sm:p-7">
        <h2 class="text-lg font-semibold text-ink mb-5">Pedir presupuesto</h2>
        <QuoteForm />
      </div>

      <div class="space-y-6">
        <div class="rounded-xl border border-line bg-white p-6">
          <h2 class="text-lg font-semibold text-ink mb-4">Datos</h2>
          <ul class="space-y-4 text-sm text-muted">
            <li>
              <span class="block text-xs text-brand font-medium mb-0.5">Teléfono</span>
              <a class="text-ink font-semibold" href={site.phoneHref}>{site.phone}</a>
            </li>
            <li>
              <span class="block text-xs text-brand font-medium mb-0.5">WhatsApp</span>
              <a class="text-ink font-semibold" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
            </li>
            <li>
              <span class="block text-xs text-brand font-medium mb-0.5">Dirección</span>
              <span class="text-ink font-semibold">{site.address}</span>
              <span class="block">{site.landmark}</span>
            </li>
            <li>
              <span class="block text-xs text-brand font-medium mb-0.5">Horario</span>
              <ul class="mt-1 space-y-1">
                {site.hours.map((row) => (
                  <li>{row.days}: {row.hours}</li>
                ))}
              </ul>
            </li>
          </ul>
        </div>
        <div class="overflow-hidden rounded-xl border border-line bg-paper aspect-[4/3]">
          <iframe
            title={`Mapa de ${site.name}`}
            src={site.mapsEmbed}
            class="h-full w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
    </div>
  </main>

  <Footer />
</Layout>
