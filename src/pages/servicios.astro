---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { servicios } from '../data/servicios';
import { site } from '../lib/site';
---

<Layout
  title={`Servicios | ${site.name}`}
  description="Fotocopias, impresión, encuadernación, plastificados, papelería y más en Reina Mercedes, Sevilla."
>
  <Navbar />

  <main class="pt-28 pb-16">
    <div class="bg-brand text-white border-b-2 border-accent px-4 py-10 sm:py-12 mb-10">
      <div class="max-w-6xl mx-auto">
        <SectionHeader
          dark
          eyebrow="Copistería e imprenta"
          title="Servicios"
          description="Impresión de planos, fotos, carteles y póster. Papelería, laminados y acabados para entregas académicas y de oficina."
        />
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line border border-line">
        {servicios.map((servicio) => <ServiceCard servicio={servicio} />)}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
