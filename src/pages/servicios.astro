---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { servicios } from '../data/servicios';
import { site } from '../lib/site';
---

<Layout
  title={`Servicios | ${site.name}`}
  description="Fotocopias, impresión, encuadernación, plastificados, papelería y más en Reina Mercedes, Sevilla."
>
  <Navbar />

  <main class="pt-28 pb-16 px-5 sm:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="mb-10 max-w-2xl">
        <SectionHeader
          eyebrow="Copistería e imprenta"
          title="Servicios"
          description="Impresión de planos, fotos, carteles y póster. Papelería, laminados y acabados para entregas académicas y de oficina."
        />
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {servicios.map((servicio) => <ServiceCard servicio={servicio} />)}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
