---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PedidoForm from '../components/PedidoForm.astro';
import { isFormatoId } from '../data/formatos';
import { site } from '../lib/site';

const raw = Astro.url.searchParams.get('formato') ?? '';
const defaultFormato = isFormatoId(raw) ? raw : 'A4';
---

<Layout
  title={`Enviar archivo | ${site.name}`}
  description="Sube un PDF, elige el folio (A4, A3…) y envía el pedido de impresión a Copistería Central."
>
  <Navbar />

  <main class="pt-28 pb-8 px-4 max-w-3xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand mb-2">Impresión</p>
    <h1 class="text-4xl font-semibold tracking-tight text-ink">Enviar archivo para imprimir</h1>
    <p class="mt-4 text-slate-600 leading-relaxed">
      Adjunta el PDF, elige el formato y las copias. Te confirmaremos la recogida en el local.
    </p>

    <div class="mt-10 rounded-xl border border-slate-200 bg-white p-6 md:p-8">
      <PedidoForm defaultFormato={defaultFormato} />
    </div>

    <p class="mt-6 text-sm text-slate-500">
      ¿Archivo muy pesado o varios planos? Llámanos al
      <a class="text-brand font-medium" href={site.phoneHref}>{site.phone}</a>
      o escríbenos por
      <a class="text-brand font-medium" href={site.whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>.
    </p>
  </main>

  <Footer />
</Layout>
