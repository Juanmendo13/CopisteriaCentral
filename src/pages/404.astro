---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
---

<Layout title={`No encontrado · ${site.name}`}>
  <main class="flex min-h-[100svh] flex-col items-center justify-center px-5 text-center">
    <p class="font-display text-6xl font-extrabold text-ink">404</p>
    <p class="mt-4 text-muted">Esta página no existe.</p>
    <a href="/" class="btn-primary mt-8">Volver al inicio</a>
  </main>
</Layout>
