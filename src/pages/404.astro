---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
---

<Layout title={`404 · ${site.brand}`}>
  <main class="mx-auto flex min-h-[70svh] max-w-6xl flex-col justify-center px-5 py-24 sm:px-8">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-hot">404</p>
    <h1 class="font-display mt-3 text-4xl font-extrabold text-fog">Not found</h1>
    <p class="mt-4 max-w-md text-mist">
      <a href="/" class="text-acid underline decoration-acid/40 underline-offset-4">Home</a>
      <span class="mx-2 text-line">·</span>
      <a href="/negocios" class="text-cyan underline decoration-cyan/40 underline-offset-4"
        >/negocios</a
      >
    </p>
  </main>
</Layout>
