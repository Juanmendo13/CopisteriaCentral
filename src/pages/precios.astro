---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PreciosCarrito from '../components/PreciosCarrito.astro';
import Doodle from '../components/Doodle.astro';
import { site } from '../lib/site';
---

<Layout
  title={`Precios y presupuesto | ${site.name}`}
  description="Consulta precios orientativos de fotocopias, impresiones y encuadernación. Añade al carrito y solicita el presupuesto oficial por email."
>
  <Navbar />

  <main class="pt-28 pb-0">
    <section class="page-hero-block px-5 sm:px-8 py-12 sm:py-16">
      <Doodle name="regla" rotate={-6} class="doodle-float-slow absolute top-10 right-10 h-8 w-32 opacity-45 hidden sm:block" />
      <div class="relative max-w-6xl mx-auto">
        <p class="text-sm font-black text-accent mb-3 uppercase tracking-[0.14em]">Carta del mostrador</p>
        <h1 class="font-display text-4xl sm:text-6xl text-white leading-[0.98]">Precios y carrito</h1>
        <p class="mt-4 max-w-2xl text-white/75 leading-relaxed text-base sm:text-lg font-medium">
          Elige fotocopias, impresiones u otros servicios básicos, añade al carrito y solicita el presupuesto oficial.
          Los importes son <strong class="font-bold text-accent">orientativos</strong>
          {site.isPrototype && ' (demo)'}. Los trabajos a medida quedan
          <strong class="font-bold text-accent"> pendientes de evaluación</strong>.
        </p>
        <p class="mt-3 text-sm text-white/60 font-semibold">
          ¿Ya tienes el PDF?
          <a href="/pedido" class="text-accent font-black hover:underline">Envía el archivo</a>
          · Papelería en
          <a href="/venta" class="text-accent font-black hover:underline">venta</a>.
        </p>
      </div>
    </section>

    <div class="paper-ruled px-5 sm:px-8 py-12 sm:py-14 border-b-[8px] border-brand">
      <div class="max-w-6xl mx-auto">
        <PreciosCarrito />
      </div>
    </div>
  </main>

  <Footer />
</Layout>
