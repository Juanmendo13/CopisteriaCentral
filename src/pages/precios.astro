---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PreciosCarrito from '../components/PreciosCarrito.astro';
import { site } from '../lib/site';
---

<Layout
  title={`Precios y presupuesto | ${site.name}`}
  description="Consulta precios orientativos de fotocopias, impresiones y encuadernación. Añade al carrito y solicita el presupuesto oficial por email."
>
  <Navbar />

  <main class="pt-28 pb-16 px-4 max-w-6xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand mb-2">
      Precios
    </p>
    <h1 class="font-display text-4xl font-bold tracking-tight text-ink">Precios y carrito</h1>
    <p class="mt-4 max-w-2xl text-stone-600 leading-relaxed">
      Elige fotocopias, impresiones u otros servicios básicos, añade al carrito y solicita el presupuesto oficial.
      Los importes son <strong class="font-semibold text-ink">orientativos</strong>
      {site.isPrototype && ' (demo)'}. Los trabajos a medida (diseño, gran formato especial…) quedan
      <strong class="font-semibold text-ink">pendientes de evaluación</strong>.
      Para papelería física, ve a <a href="/venta" class="font-semibold text-brand hover:underline">venta</a>.
    </p>
    <p class="mt-3 text-sm text-stone-500">
      ¿Ya tienes el PDF listo?
      <a href="/pedido" class="font-semibold text-brand hover:underline">Envía el archivo</a>
      directamente.
    </p>

    <div class="mt-10">
      <PreciosCarrito />
    </div>
  </main>

  <Footer />
</Layout>
