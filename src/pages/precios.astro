---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PreciosCarrito from '../components/PreciosCarrito.astro';
import { site } from '../lib/site';
---

<Layout
  title={`Precios y presupuesto | ${site.name}`}
  description="Consulta precios orientativos de fotocopias, impresiones y encuadernación. Añade al carrito y solicita el presupuesto oficial por email."
>
  <Navbar />

  <main class="pt-28 pb-16 px-4 max-w-6xl mx-auto">
    <p class="stamp text-brand mb-4">Tarifa de puerta</p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold tracking-tight text-ink">Lo que cuesta, a la vista</h1>
    <p class="mt-4 max-w-2xl text-muted leading-relaxed">
      Elige copias, impresiones o espiral y arma el presupuesto. Los importes son
      <strong class="font-semibold text-ink">orientativos</strong>
      {site.isPrototype && ' (esto es una demo)'}. Lo que se sale de la tarifa —diseño, gran formato raro—
      se mira en el local. La papelería está en
      <a href="/venta" class="font-semibold text-brand hover:underline">el estante</a>.
    </p>
    <p class="mt-3 text-sm text-stone-500">
      ¿Ya tienes el PDF listo?
      <a href="/pedido" class="font-semibold text-brand hover:underline">Envía el archivo</a>
      directamente.
    </p>

    <div class="mt-10">
      <PreciosCarrito />
    </div>
  </main>

  <Footer />
</Layout>
