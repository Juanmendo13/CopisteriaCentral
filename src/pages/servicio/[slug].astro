---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { getServicio } from '../../data/servicios';
import { SERVICIO_FORMATO, servicioEsPedido } from '../../data/formatos';
import { site } from '../../lib/site';

const { slug } = Astro.params;
const servicio = slug ? getServicio(slug) : undefined;

if (!servicio) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const pedidoFormato = SERVICIO_FORMATO[servicio.slug] ?? 'A4';
const pedidoHref = `/pedido?formato=${encodeURIComponent(pedidoFormato)}`;

if (servicioEsPedido(servicio.slug)) {
  return Astro.redirect(pedidoHref);
}

if (servicio.slug === 'papeleria') {
  return Astro.redirect('/venta');
}
---

<Layout
  title={`${servicio.title} | ${site.name}`}
  description={servicio.short}
>
  <Navbar />

  <main class="pt-28 pb-8 px-4 max-w-6xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand mb-2">
      <a href="/servicios" class="hover:underline">Servicios</a>
      <span class="text-slate-300 mx-2">/</span>
      {servicio.title}
    </p>
    <h1 class="font-display text-4xl font-bold tracking-tight text-ink">{servicio.title}</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 leading-relaxed">{servicio.body}</p>

    {
      servicio.formats && (
        <p class="mt-6 text-sm font-medium text-slate-500">
          Formatos: {servicio.formats.join(' · ')}
        </p>
      )
    }

    <ul class="mt-8 grid sm:grid-cols-2 gap-2">
      {
        servicio.items.map((item) => (
          <li class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700">
            {item}
          </li>
        ))
      }
    </ul>

    {
      servicio.extra?.map((note) => (
        <p class="mt-6 text-sm text-slate-500">{note}</p>
      ))
    }

    <div class="mt-10 rounded-xl border border-blue-100 bg-brand-soft/60 px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-sm text-slate-700">
        ¿Ya tienes el archivo? Envíalo para imprimir en {pedidoFormato}.
      </p>
      <a href={pedidoHref} class="inline-flex justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-dark">
        Enviar PDF
      </a>
    </div>

    <div class="mt-10 grid lg:grid-cols-2 gap-10 items-start">
      <div class="rounded-xl border border-slate-200 bg-white p-6 md:p-8">
        <h2 class="text-lg font-semibold text-ink mb-2">Presupuesto de {servicio.title.toLowerCase()}</h2>
        <p class="text-sm text-slate-600 mb-6">Indica formato, copias y fecha. Te respondemos por teléfono.</p>
        <QuoteForm defaultServicio={servicio.slug} />
      </div>
      <aside class="text-sm text-slate-600 leading-relaxed">
        <p class="font-semibold text-ink mb-2">Recogida en local</p>
        <p>
          {site.address}. {site.landmark}.
        </p>
        <p class="mt-3">
          <a href={site.phoneHref} class="text-brand font-medium">{site.phone}</a>
        </p>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>
