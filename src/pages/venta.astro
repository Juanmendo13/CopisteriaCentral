---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import VentaCarrito from '../components/VentaCarrito.astro';
import Doodle from '../components/Doodle.astro';
import { venta, ventaCategorias } from '../data/venta';
import { site } from '../lib/site';
---

<Layout
  title={`Venta de papelería | ${site.name}`}
  description="Bolis, libretas, carpetas y lo de apuro. Haz tu lista y reservamos en Copistería Central, Reina Mercedes."
>
  <Navbar />

  <main class="pt-28 pb-0 relative overflow-hidden">
    <section class="page-hero-block px-5 sm:px-8 py-12 sm:py-16">
      <Doodle name="boli" rotate={14} class="doodle-float absolute top-10 right-8 h-16 w-6 opacity-50 hidden lg:block" />
      <Doodle name="postit" rotate={-8} class="doodle-wiggle absolute bottom-12 left-8 h-12 w-12 opacity-40 hidden md:block" />
      <div class="relative max-w-6xl mx-auto">
        <p class="text-sm font-black text-accent mb-3 inline-flex items-center gap-2 uppercase tracking-[0.14em]">
          <Doodle name="cuaderno" class="h-5 w-4" rotate={-6} />
          Del mostrador
        </p>
        <h1 class="font-display text-4xl sm:text-6xl text-white leading-[0.98] max-w-3xl">
          Papelería para el día a día
        </h1>
        <p class="mt-4 max-w-2xl text-white/75 leading-relaxed text-base sm:text-lg font-medium">
          Bolis, libretas, carpetas y lo que siempre se te olvida ({venta.length} artículos, precios orientativos).
          Haz tu lista y te lo reservamos para cuando pases.
        </p>
      </div>
    </section>

    <div class="band-mustard border-t-0">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-4 space-y-3">
        <div class="relative max-w-xl">
          <label for="venta-search" class="block text-xs font-black uppercase tracking-[0.14em] text-brand mb-1.5">
            Buscar en el mostrador
          </label>
          <div class="relative">
            <input
              id="venta-search"
              type="search"
              name="venta-search"
              autocomplete="off"
              enterkeyhint="search"
              placeholder="Bolígrafo, carpeta, USB…"
              class="field-stamp !pr-11"
              aria-controls="venta-catalogo"
              aria-describedby="venta-search-hint"
            />
            <button
              type="button"
              id="venta-search-clear"
              class="absolute right-2 top-1/2 -translate-y-1/2 hidden h-8 w-8 rounded-sm border-2 border-brand bg-white text-brand text-lg font-black leading-none hover:bg-brand hover:text-accent transition"
              aria-label="Borrar búsqueda"
            >
              ×
            </button>
          </div>
          <p id="venta-search-hint" class="sr-only">
            Filtra los productos por nombre, descripción o categoría mientras escribes.
          </p>
        </div>
        <nav class="flex flex-wrap gap-2" aria-label="Categorías" id="venta-cat-nav">
          {
            ventaCategorias.map((cat) => (
              <a
                href={`#${cat.toLowerCase().replace(/[^a-z0-9]+/gi, '-')}`}
                data-venta-cat={cat.toLowerCase().replace(/[^a-z0-9]+/gi, '-')}
                class="rounded-sm border-2 border-brand bg-white px-3 py-1.5 text-xs font-bold text-brand hover:bg-brand hover:text-accent transition"
              >
                {cat}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <div class="relative paper-dots px-3 sm:px-8 py-8 sm:py-14">
      <div class="relative max-w-6xl mx-auto">
        <VentaCarrito />
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* Custom stamp clear button; hide native WebKit cancel */
  #venta-search::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }
</style>
