---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import VentaCarrito from '../components/VentaCarrito.astro';
import { venta, ventaCategorias } from '../data/venta';
import { site } from '../lib/site';
---

<Layout
  title={`Venta de papelería | ${site.name}`}
  description="Bolígrafos, libretas, carpetas, grapadoras y más. Añade a tu lista y reserva en Copistería Central, Reina Mercedes."
>
  <Navbar />

  <main class="pt-28 pb-16 px-5 sm:px-8">
    <div class="max-w-6xl mx-auto mb-8">
      <p class="text-sm font-medium text-brand mb-2">Tienda</p>
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-ink">Venta de papelería</h1>
      <p class="mt-3 max-w-2xl text-muted leading-relaxed">
        Material de escritorio, archivo, corte y embalaje. Precios orientativos ({venta.length} artículos).
        Añade lo que necesites y te lo reservamos en el local.
      </p>
      <nav class="mt-5 flex flex-wrap gap-2" aria-label="Categorías">
        {
          ventaCategorias.map((cat) => (
            <a
              href={`#${cat.toLowerCase().replace(/[^a-z0-9]+/gi, '-')}`}
              class="rounded-md border border-line bg-white px-3 py-1.5 text-xs font-medium text-ink hover:border-brand/40 hover:bg-brand-soft/50 transition"
            >
              {cat}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="max-w-6xl mx-auto">
      <VentaCarrito />
    </div>
  </main>

  <Footer />
</Layout>
