---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { fotos } from '../data/galeria';
import { site } from '../lib/site';
---

<Layout
  title={`Imágenes | ${site.name}`}
  description="Imágenes de Copistería Central en Av. Reina Mercedes, Sevilla. Galería provisional hasta fotos reales del local."
>
  <Navbar />

  <main class="pt-28 pb-16 px-4 max-w-6xl mx-auto">
    <div class="rounded-3xl bg-gradient-to-br from-stone-100 to-white border border-stone-200/80 p-8 sm:p-10 mb-10">
      <SectionHeader
        eyebrow="Galería"
        title="Imágenes"
        description="Aún no tenemos fotos propias del local publicadas aquí. Mientras tanto, esta ilustración de marca y la ficha en Google Maps."
      />
      <p class="mt-4 text-sm text-ink/70">
        <a href={site.mapsUrl} class="font-bold text-brand underline decoration-accent underline-offset-2 hover:text-brand-dark" target="_blank" rel="noopener noreferrer">
          Ver Copistería Central en Google Maps
        </a>
      </p>
    </div>

    {
      fotos.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl">
          {fotos.map((item) => (
            <figure class="overflow-hidden rounded-xl border border-line bg-white shadow-sm aspect-[4/3]">
              <img
                src={item.image}
                alt={item.alt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>
      ) : (
        <p class="text-ink/70 text-base">Sin fotos en la galería por ahora.</p>
      )
    }
  </main>

  <Footer />
</Layout>
