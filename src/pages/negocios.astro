---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NegociosLeadForm from '../components/NegociosLeadForm.astro';
import { getBusinessProjects } from '../data/projects';
import { site } from '../lib/site';

const cases = getBusinessProjects();
const benefits = [1, 2, 3, 4, 5, 6] as const;
const steps = [1, 2, 3] as const;
const faqs = [1, 2, 3, 4] as const;
const pitteriSala = 'https://pitteri.vercel.app/sala/';
const pitteriWeb = 'https://pitteri.vercel.app';
---

<Layout
  title={`${site.brand} · Negocios`}
  descriptionKey="meta.negocios.description"
>
  <Nav variant="negocios" />

  <section class="relative isolate min-h-[88svh] overflow-hidden text-fog">
    <div class="absolute inset-0 -z-10 bg-void">
      <img
        src="/portfolio/hero-cyberpunk.jpg"
        alt=""
        class="absolute inset-0 h-full w-full scale-105 object-cover object-[center_35%] opacity-55"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 bg-[linear-gradient(180deg,rgb(5_8_15_/_0.55)_0%,rgb(5_8_15_/_0.45)_45%,rgb(5_8_15_/_0.92)_100%),radial-gradient(ellipse_at_15%_20%,rgb(184_255_61_/_0.1),transparent_45%)]"
        aria-hidden="true"
      >
      </div>
      <div class="grid-floor absolute inset-0 opacity-40" aria-hidden="true"></div>
    </div>

    <div
      class="mx-auto flex min-h-[88svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 sm:px-8 sm:pb-20"
    >
      <p
        class="animate-rise font-mono text-[11px] uppercase tracking-[0.28em] text-cyan sm:text-xs"
        data-i18n="neg.hero.kicker"
      >
        Webs para locales · Sevilla / Milano
      </p>
      <p
        class="animate-rise-delay-1 font-display mt-4 text-[clamp(2.2rem,10vw,5.5rem)] font-extrabold leading-[0.92] tracking-[-0.04em] text-acid"
      >
        {site.brand}<span class="text-cyan">_</span>
      </p>
      <div
        class="animate-pulse-line mt-5 h-px w-28 bg-gradient-to-r from-acid via-cyan to-transparent sm:w-40"
        aria-hidden="true"
      >
      </div>
      <h1
        class="animate-rise-delay-2 mt-6 max-w-2xl font-display text-2xl font-bold leading-tight tracking-tight text-fog sm:text-3xl lg:text-[2.2rem]"
        data-i18n="neg.hero.headline"
      >
        Una web que vende y recibe pedidos — sin líos técnicos.
      </h1>
      <p
        class="animate-rise-delay-2 mt-4 max-w-xl text-base font-medium leading-relaxed text-mist sm:text-lg"
        data-i18n="neg.hero.lead"
      >
        Carta, catálogo, pedidos al email/móvil, stock, y —si lo necesitas— comandería/TPV de bar.
      </p>
      <p
        class="animate-rise-delay-2 mt-4 font-mono text-sm uppercase tracking-[0.14em] text-acid"
        data-i18n="neg.hero.price"
      >
        TPV/comandera: 200€ pago único · web: presupuesto a medida
      </p>
      <div class="animate-rise-delay-3 mt-8 flex flex-wrap gap-3">
        <a href="#contacto" class="btn-primary" data-i18n="neg.hero.ctaContact">Pedir presupuesto</a>
        <a href="#casos" class="btn-ghost" data-i18n="neg.hero.ctaCases">Ver casos reales</a>
      </div>
    </div>
  </section>

  <main>
    <section id="que-hago" class="scroll-mt-8 border-t border-line bg-void px-5 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-2xl">
          <p
            class="font-mono text-[11px] uppercase tracking-[0.22em] text-acid"
            data-i18n="neg.benefits.kicker"
          >
            Qué te hago
          </p>
          <h2
            class="font-display mt-3 text-3xl font-extrabold tracking-tight text-fog sm:text-4xl"
            data-i18n="neg.benefits.title"
          >
            Beneficios claros, sin jerga.
          </h2>
          <p
            class="mt-4 text-base font-medium leading-relaxed text-mist sm:text-lg"
            data-i18n="neg.benefits.lead"
          >
            Cosas que notas en el día a día del local — no listas de herramientas.
          </p>
        </header>

        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            benefits.map((n) => (
              <li class="border-l border-cyan/40 pl-4">
                <h3
                  class="font-display text-lg font-bold text-fog"
                  data-i18n={`neg.benefits.b${n}.title`}
                >
                  —
                </h3>
                <p
                  class="mt-2 text-sm font-medium leading-relaxed text-mist sm:text-base"
                  data-i18n={`neg.benefits.b${n}.body`}
                >
                  —
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="border-t border-line bg-void-2 px-5 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-2xl">
          <p
            class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan"
            data-i18n="neg.how.kicker"
          >
            Cómo funciona
          </p>
          <h2
            class="font-display mt-3 text-3xl font-extrabold tracking-tight text-fog sm:text-4xl"
            data-i18n="neg.how.title"
          >
            Tres pasos. Sin rodeos.
          </h2>
        </header>
        <ol class="grid gap-8 md:grid-cols-3">
          {
            steps.map((n) => (
              <li>
                <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-acid">0{n}</p>
                <h3
                  class="font-display mt-2 text-xl font-bold text-fog"
                  data-i18n={`neg.how.s${n}.title`}
                >
                  —
                </h3>
                <p
                  class="mt-2 text-sm font-medium leading-relaxed text-mist sm:text-base"
                  data-i18n={`neg.how.s${n}.body`}
                >
                  —
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="casos" class="scroll-mt-8 border-t border-line bg-void px-5 py-20 sm:px-8 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <header class="mb-12 max-w-2xl">
          <p
            class="font-mono text-[11px] uppercase tracking-[0.22em] text-acid"
            data-i18n="neg.cases.kicker"
          >
            Casos reales
          </p>
          <h2
            class="font-display mt-3 text-3xl font-extrabold tracking-tight text-fog sm:text-4xl"
            data-i18n="neg.cases.title"
          >
            Locales que ya tienen su web.
          </h2>
          <p
            class="mt-4 text-base font-medium leading-relaxed text-mist sm:text-lg"
            data-i18n="neg.cases.lead"
          >
            Copistería, ferretería, bar, pizzería, imprenta y pub.
          </p>
        </header>

        <ul class="space-y-6">
          {
            cases.map((project, i) => (
              <li class="group border border-line bg-panel/50">
                <div class="grid gap-0 lg:grid-cols-12">
                  <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-void-2 lg:col-span-4 lg:aspect-auto lg:min-h-[220px] lg:border-b-0 lg:border-r">
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={`Captura de ${project.name}`}
                        class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.02]"
                        width="1440"
                        height="900"
                        loading={i < 2 ? 'eager' : 'lazy'}
                      />
                    ) : null}
                    <span class="absolute bottom-3 left-3 font-mono text-[10px] uppercase tracking-[0.2em] text-cyan">
                      {project.year}
                    </span>
                  </div>
                  <div class="flex flex-col px-5 py-6 sm:px-7 sm:py-8 lg:col-span-8">
                    <h3 class="font-display text-2xl font-extrabold tracking-tight text-fog">
                      {project.name}
                    </h3>
                    <p
                      class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-hot"
                      data-proj={project.slug}
                      data-proj-field="client"
                    >
                      {project.client.es}
                    </p>
                    <p
                      class="mt-4 max-w-2xl text-base font-medium leading-relaxed text-mist"
                      data-proj={project.slug}
                      data-proj-field="humanPitch"
                    >
                      {project.humanPitch?.es ?? project.pitch.es}
                    </p>
                    {project.humanBullets?.length ? (
                      <ul class="mt-4 space-y-2">
                        {project.humanBullets.map((bullet, bi) => (
                          <li class="flex gap-2 text-sm leading-snug text-fog/90">
                            <span
                              class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-acid"
                              aria-hidden="true"
                            />
                            <span data-proj={project.slug} data-proj-field={`hb:${bi}`}>
                              {bullet.es}
                            </span>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                    <div class="mt-6 flex flex-wrap gap-3">
                      {project.live ? (
                        <a
                          href={project.live}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-primary"
                          data-i18n="neg.cases.live"
                        >
                          Visitar
                        </a>
                      ) : null}
                      {project.demos?.map((demo, di) => (
                        <a
                          href={demo.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-ghost"
                        >
                          <span data-proj={project.slug} data-proj-field={`demo:${di}`}>
                            {demo.label.es}
                          </span>
                        </a>
                      ))}
                      <a href="/#proyectos" class="btn-ghost" data-i18n="neg.cases.tech">
                        Detalle técnico
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="tpv" class="scroll-mt-8 border-t border-line bg-void-2 px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-6xl">
        <p
          class="font-mono text-[11px] uppercase tracking-[0.22em] text-hot"
          data-i18n="neg.tpv.kicker"
        >
          TPV / comandera
        </p>
        <h2
          class="font-display mt-3 max-w-2xl text-3xl font-extrabold tracking-tight text-fog sm:text-4xl"
          data-i18n="neg.tpv.title"
        >
          Comandería de bar: 200€ pago único.
        </h2>
        <p
          class="mt-4 max-w-2xl text-base font-medium leading-relaxed text-mist sm:text-lg"
          data-i18n="neg.tpv.lead"
        >
          TPV/comandera base (como la demo `/sala/`): 200€ pago único, sin mensualidades. La web del
          local se presupuesta aparte.
        </p>
        <p
          class="mt-3 font-mono text-sm uppercase tracking-[0.16em] text-acid"
          data-i18n="neg.tpv.price"
        >
          200€ · solo TPV/comandera · sin mensualidades
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={pitteriSala}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
            data-i18n="neg.tpv.cta"
          >
            Abrir demo /sala
          </a>
          <a
            href={pitteriWeb}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
            data-i18n="neg.tpv.ctaWeb"
          >
            Ver web del bar
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-void px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-6xl grid gap-12 lg:grid-cols-2">
        <div>
          <p
            class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan"
            data-i18n="neg.pricing.kicker"
          >
            Precio
          </p>
          <h2
            class="font-display mt-3 text-3xl font-extrabold tracking-tight text-acid sm:text-4xl"
            data-i18n="neg.pricing.title"
          >
            200€ = TPV. La web, a medida.
          </h2>
          <p
            class="mt-4 text-base font-medium leading-relaxed text-mist"
            data-i18n="neg.pricing.lead"
          >
            Los 200€ pago único son solo para la comandería/TPV base. La web del local se
            presupuesta aparte vía formulario.
          </p>
          <p
            class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-cyan"
            data-i18n="neg.pricing.note"
          >
            TPV: 200€ pago único · Web: presupuesto por formulario · sin compromiso
          </p>
          <a href="#contacto" class="btn-primary mt-8 inline-flex" data-i18n="neg.pricing.cta">
            Ir al formulario
          </a>
        </div>
        <div>
          <p
            class="font-mono text-[11px] uppercase tracking-[0.22em] text-acid"
            data-i18n="neg.faq.kicker"
          >
            Preguntas
          </p>
          <h2
            class="font-display mt-3 text-3xl font-extrabold tracking-tight text-fog"
            data-i18n="neg.faq.title"
          >
            Lo que suelen preguntar.
          </h2>
          <dl class="mt-8 space-y-6">
            {
              faqs.map((n) => (
                <div>
                  <dt
                    class="font-display text-lg font-bold text-fog"
                    data-i18n={`neg.faq.q${n}`}
                  >
                    —
                  </dt>
                  <dd
                    class="mt-2 text-sm font-medium leading-relaxed text-mist sm:text-base"
                    data-i18n={`neg.faq.a${n}`}
                  >
                    —
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section
      id="contacto"
      class="scroll-mt-8 border-t border-line bg-void px-5 py-20 sm:px-8 sm:py-28"
    >
      <div class="mx-auto max-w-6xl">
        <div class="relative max-w-3xl overflow-hidden border border-line bg-panel/70 p-6 sm:p-10">
          <div
            class="pointer-events-none absolute -right-8 -top-8 h-40 w-40 rounded-full bg-cyan/10 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <p
            class="font-mono text-[11px] uppercase tracking-[0.22em] text-cyan"
            data-i18n="neg.contact.kicker"
          >
            Empezar
          </p>
          <h2
            class="font-display mt-3 text-3xl font-extrabold tracking-tight text-fog sm:text-4xl"
            data-i18n="neg.contact.title"
          >
            Cuéntame tu local.
          </h2>
          <p
            class="mt-4 text-base font-medium leading-relaxed text-mist sm:text-lg"
            data-i18n="neg.contact.lead"
          >
            Rellena esto y te respondo con una propuesta clara.
          </p>
          <div class="mt-8">
            <NegociosLeadForm />
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter variant="negocios" />
</Layout>
