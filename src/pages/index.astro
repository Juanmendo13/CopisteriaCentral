---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';
import HomeHero from '../components/HomeHero.astro';
import ServiceIconsRow from '../components/ServiceIconsRow.astro';
import UtilityStrip from '../components/UtilityStrip.astro';
import HomeExtras from '../components/HomeExtras.astro';
import HomePrecios from '../components/HomePrecios.astro';
import SectionHeader from '../components/SectionHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { servicios } from '../data/servicios';
import { site } from '../lib/site';
---

<Layout title={`${site.name} | Copistería en Sevilla`}>
  <HomeHero />
  <UtilityStrip />
  <ServiceIconsRow />

  <main>
    <section id="servicios" class="scroll-mt-24 bg-white py-14 sm:py-16 px-5 sm:px-8">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
          <SectionHeader
            eyebrow="Servicios"
            title="Del PDF al mostrador"
            description="Copias, color, espiral y plastificado. Te lo dejamos listo para llevar."
          />
          <a href="/servicios" class="btn-secondary-light shrink-0 inline-flex items-center px-4 py-2 text-sm self-start">
            Ver todos
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {servicios.map((servicio) => <ServiceCard servicio={servicio} />)}
        </div>
      </div>
    </section>

    <HomePrecios />

    <HomeExtras />

    <section class="px-5 sm:px-8 py-14 sm:py-16">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_0.9fr] gap-8 lg:gap-12 items-start">
        <div>
          <p class="stamp text-brand mb-4">El local</p>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-4 leading-tight">
            Aquí se habla de tú, y se mira el archivo antes de imprimir
          </h2>
          <p class="text-muted leading-relaxed">
            El del trabajo a medias, el del plano enrollado y el de las diez copias antes de clase. Si algo no va a salir bien, te lo decimos en el mostrador, no cuando ya está impreso.
          </p>
          <ul class="mt-5 space-y-2 text-sm text-ink">
            <li>Te atienden en persona, en el Local B</li>
            <li>PDF, JPG o PNG: lo que lleves encima</li>
            <li>Recoges en {site.addressLine}</li>
          </ul>
          <a href="/informacion" class="mt-6 inline-flex text-sm font-semibold text-brand hover:underline">
            Cómo es el negocio →
          </a>
        </div>
        <div class="counter-note p-6 sm:p-7 rotate-[-0.4deg]">
          <h3 class="font-display italic text-2xl text-ink mb-1">Pide precio sin dar vueltas</h3>
          <p class="text-sm text-muted mb-5">
            Con archivo: <a href="/pedido" class="text-brand font-semibold hover:underline">tráelo</a>.
            Papelería: <a href="/venta" class="text-brand font-semibold hover:underline">monta la lista</a>.
          </p>
          <QuoteForm compact />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
